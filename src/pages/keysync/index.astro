---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { DEFAULT_LOCALE } from '../../i18n/config';

const PAGE_TITLE = 'KeySync — One config for every AI agent';
const PAGE_DESCRIPTION =
	'KeySync is the key and config layer your AI agents read from. Keep your providers, keys, models, and endpoints in one place and sync them to every AI agent you run — encrypted across machines, with a local backup before every write.';

// English-only for now. The lang switcher reports other locales as
// unavailable rather than inventing a fallback (DR-001, no fake equivalents).
const translations = { en: '/keysync/' } as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([locale, path]) => ({
		locale,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			lang={DEFAULT_LOCALE}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={DEFAULT_LOCALE} translations={translations} />
		<main class="ks-main">
			<!-- HERO -->
			<header class="ks-band ks-hero-band">
				<div class="ks-wrap ks-hero">
					<span class="tag"><span class="ks-dot" aria-hidden="true"></span>Key &amp; config sync for AI agents</span>
					<h1>Stop re-pasting API keys into <span class="ks-hl">every</span> AI agent.</h1>
					<p class="ks-sub">
						Keep your <b>providers, keys, models, and endpoints</b> in one provider profile, then sync
						them to Claude Code, OpenClaw, Hermes, and the rest — <b>encrypted across every machine</b>,
						with a <b>local backup before every write</b>.
					</p>
					<div class="ks-cta-row">
						<a href="#get-started" class="button primary">
							Start syncing — free for a month
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
						</a>
						<a href="#how" class="button">See how it works</a>
					</div>
					<ul class="ks-trust">
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Backup before every write</li>
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>End-to-end encrypted</li>
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Writes each tool's native config</li>
					</ul>

					<!-- HERO VISUAL: source of truth -> hub -> tools -->
					<div class="ks-stage">
						<div class="ks-stage-frame">
							<div class="ks-stage-grid">
								<!-- LEFT: source of truth -->
								<div class="ks-panel">
									<div class="ks-panel-label">Source of truth <span class="ks-tagged">1 place</span></div>
									<div class="ks-kv"><span class="k">anthropic</span><span class="v secret">sk-ant-••••</span></div>
									<div class="ks-kv"><span class="k">openai</span><span class="v secret">sk-••••••••</span></div>
									<div class="ks-kv"><span class="k">google</span><span class="v secret">AIza••••••</span></div>
									<div class="ks-kv"><span class="k">model</span><span class="v">claude-opus-4</span></div>
									<div class="ks-kv"><span class="k">endpoint</span><span class="v">api.proxy.dev</span></div>
								</div>

								<!-- MIDDLE: hub -->
								<div class="ks-hub">
									<div class="ks-hub-core">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
									</div>
									<div class="ks-hub-name">KeySync</div>
									<div class="ks-hub-backup"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>backup saved</div>
								</div>

								<!-- RIGHT: tools -->
								<div class="ks-tools">
									<div class="ks-toolcard">
										<div class="ks-tool-ico">CC</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">Claude Code</div><div class="ks-tool-path">~/.claude/settings.json</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>synced</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">OC</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">OpenClaw</div><div class="ks-tool-path">~/.openclaw/openclaw.json</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>synced</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">He</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">Hermes</div><div class="ks-tool-path">~/.hermes/config.yaml</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>synced</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">Cx</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">Codex CLI</div><div class="ks-tool-path">~/.codex/config.toml</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>synced</div>
									</div>
								</div>

								<!-- animated connectors -->
								<svg class="ks-flow" preserveAspectRatio="none" viewBox="0 0 1000 260" aria-hidden="true">
									<line x1="320" y1="130" x2="445" y2="130"></line>
									<line x1="555" y1="130" x2="680" y2="60"></line>
									<line x1="555" y1="130" x2="680" y2="107"></line>
									<line x1="555" y1="130" x2="680" y2="153"></line>
									<line x1="555" y1="130" x2="680" y2="200"></line>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</header>

			<!-- PROBLEM -->
			<section class="ks-band ks-problem">
				<div class="ks-wrap ks-problem-grid">
					<div>
						<div class="ks-sec-eyebrow">Config sprawl</div>
						<h2 class="ks-sec-title">One provider profile. Every agent configured.</h2>
						<ul class="ks-pain-list">
							<li><span class="ks-x" aria-hidden="true">✕</span><span>Every tool wants its <b>own config file</b>, in its own format and location.</span></li>
							<li><span class="ks-x" aria-hidden="true">✕</span><span>Rotate one key and you're <b>hand-editing six files</b> across every project and machine.</span></li>
							<li><span class="ks-x" aria-hidden="true">✕</span><span>A bad edit can <b>break your setup mid-task</b> — with no easy way back.</span></li>
							<li><span class="ks-x" aria-hidden="true">✕</span><span>New laptop? Start the whole <b>copy-paste ritual</b> from scratch.</span></li>
						</ul>
					</div>
					<div class="ks-codecard">
						<div class="ks-codebar"><span class="ks-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ks-fname">~/.codex/config.toml</span></div>
						<pre class="ks-codebody"><span class="c"># before — edited by hand, again</span>
[model_providers.openai]
<span class="old">api_key = "sk-OLD-rotated-key…"</span>
<span class="new">api_key = "sk-NEW-synced-by-keysync"</span>
base_url = <span class="s">"https://api.proxy.dev/v1"</span>
model = <span class="s">"claude-opus-4"</span>

<span class="c"># the local client backed up the previous</span>
<span class="c"># file to its backup manifest first</span></pre>
					</div>
				</div>
			</section>

			<!-- HOW IT WORKS -->
			<section class="ks-band" id="how">
				<div class="ks-wrap">
					<div class="ks-sec-head">
						<div class="ks-sec-eyebrow">How it works</div>
						<h2 class="ks-sec-title">Three steps. Then never touch a config file again.</h2>
					</div>
					<div class="ks-steps">
						<div class="ks-step">
							<div class="ks-step-n">1</div>
							<h3>Build a provider profile</h3>
							<p>Bundle your API keys, default models, and custom endpoints into one profile — Anthropic, OpenAI, Google, OpenRouter, or your own local gateway.</p>
						</div>
						<div class="ks-step">
							<div class="ks-step-n">2</div>
							<h3>Pick your tools</h3>
							<p>Choose which agents and tools KeySync manages: <code>Claude Code</code>, <code>Codex</code>, <code>OpenClaw</code>, <code>Hermes</code>, and more.</p>
						</div>
						<div class="ks-step">
							<div class="ks-step-n">3</div>
							<h3>Sync everywhere</h3>
							<p>KeySync writes each tool's native config for you. Change a key once and it lands in every tool, on every machine.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- FEATURES -->
			<section class="ks-band ks-features" id="features">
				<div class="ks-wrap">
					<div class="ks-sec-head">
						<div class="ks-sec-eyebrow">What you get</div>
					</div>
					<div class="ks-feat-grid">
						<div class="ks-feat">
							<div class="ks-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M12 1v6m0 6v10M4.2 4.2l4.3 4.3m7 7 4.3 4.3M1 12h6m6 0h10"></path></svg></div>
							<h3>One source of truth</h3>
							<p>Keys, models, and endpoints live in one place. Rotate a key once and every tool updates — no more grepping through scattered config files.</p>
						</div>
						<div class="ks-feat">
							<div class="ks-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg></div>
							<h3>Native to every agent</h3>
							<p>KeySync writes each agent's own format and file location, so they just work — no wrappers, no proxies, nothing for them to learn.</p>
						</div>
						<div class="ks-feat">
							<div class="ks-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div>
							<h3>Encrypted, everywhere</h3>
							<p>Your keys are end-to-end encrypted on your device before they ever sync — the cloud only holds ciphertext. They follow you to every machine you sign in on.</p>
						</div>
						<div class="ks-feat">
							<div class="ks-feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg></div>
							<h3>Safe by default</h3>
							<p>Every write is preceded by a local backup. Apply reports show which devices synced and which need attention — visible status instead of silent failure.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- SECURITY -->
			<section class="ks-band ks-security" id="security">
				<div class="ks-wrap ks-sec-split">
					<div>
						<div class="ks-sec-eyebrow">Built for handling secrets</div>
						<h2 class="ks-sec-title">It's holding your keys. So it's built to earn that.</h2>
						<p class="ks-sec-lead">KeySync is designed around one rule: it should never be the reason something broke or leaked.</p>
						<ul class="ks-check-list">
							<li><span class="ks-ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg></span><div><div class="t">Encrypted before it leaves your machine</div><div class="d">Your keys are encrypted client-side — the cloud only ever stores ciphertext.</div></div></li>
							<li><span class="ks-ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg></span><div><div class="t">Local backup before every write</div><div class="d">Each tool's existing config is saved locally first, so a sync can never silently overwrite your setup.</div></div></li>
							<li><span class="ks-ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg></span><div><div class="t">Visible status instead of silent failure</div><div class="d">Apply reports flag which devices synced and which still need attention.</div></div></li>
							<li><span class="ks-ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg></span><div><div class="t">Writes the explicit config files your tools already read</div><div class="d">Known files in their own formats — no vague compatibility claim.</div></div></li>
						</ul>
					</div>
					<!-- IMAGE SLOT: drop a real product screenshot here (e.g. the Web Console Providers list or the device status view) -->
					<div class="ks-imgslot">
						<span class="ks-badge">Image slot</span>
						<p>Drop a real KeySync screenshot here — e.g. the Web Console Providers list or the device status view.</p>
					</div>
				</div>
			</section>

			<!-- FAQ -->
			<section class="ks-band" id="faq">
				<div class="ks-wrap">
					<div class="ks-sec-head ks-center">
						<div class="ks-sec-eyebrow">Questions</div>
						<h2 class="ks-sec-title ks-mx-auto">Good things to know</h2>
					</div>
					<div class="ks-faq">
						<details open>
							<summary>Which AI agents and tools does it support?<span class="ks-plus" aria-hidden="true">+</span></summary>
							<p>The ones you already run — Claude Code, Codex, OpenClaw, and Hermes, with more added regularly. KeySync writes each one's native config file, so support is really just about knowing the format.</p>
						</details>
						<details>
							<summary>How are my API keys stored?<span class="ks-plus" aria-hidden="true">+</span></summary>
							<p>Keys are encrypted on your machine before they're ever uploaded. The cloud stores only encrypted data so your setup can follow you across devices — but your secrets stay yours.</p>
						</details>
						<details>
							<summary>What if a sync breaks my config?<span class="ks-plus" aria-hidden="true">+</span></summary>
							<p>It won't silently. KeySync saves a local backup of each file before writing, and the apply report flags any device that didn't sync cleanly — so failures are visible rather than silent.</p>
						</details>
						<details>
							<summary>Can I use custom endpoints or a local gateway?<span class="ks-plus" aria-hidden="true">+</span></summary>
							<p>Yes. Set a custom base URL per provider — a proxy, a self-hosted gateway, or a local model server — and KeySync points every tool at it.</p>
						</details>
						<details>
							<summary>Do my agents need to change anything?<span class="ks-plus" aria-hidden="true">+</span></summary>
							<p>No. KeySync writes the same config files your agents already read. There's nothing for them to integrate with and nothing new to learn — KeySync is the key and config layer beneath them, not another agent.</p>
						</details>
					</div>
				</div>
			</section>

			<!-- FINAL CTA -->
			<section class="ks-band ks-final" id="get-started">
				<div class="ks-wrap">
					<div class="ks-final-card">
						<h2>Set it once. <span class="ks-hl">Sync it everywhere.</span></h2>
						<p>Connect your first provider and push your config to every AI agent in under a minute.</p>
						<div class="ks-cta-row ks-center">
							<a href="#get-started" class="button primary">
								Start syncing — free for a month
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
							</a>
							<a href="#how" class="button">Read the docs</a>
						</div>
						<div class="ks-run">$ ./keysync &nbsp;·&nbsp; requires Node.js 24+</div>
					</div>
				</div>
			</section>
		</main>
		<Footer lang={DEFAULT_LOCALE} />
	</body>

	<style>
	/* KeySync subsite — ported into the SubLang light design system.
	   Reuses global tokens (--ink, --accent, --line, --surface, fonts) and the
	   shared .button / .tag / .card styles; ks- classes add layout local to
	   this page. */
	.ks-main {
		--ks-mono: var(--font-mono);
		--ks-danger: #c0392b;
		--ks-danger-soft: rgba(192, 57, 43, 0.09);
		--ks-surface-2: #faf7f1;
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	/* Full-width section bands with a centered inner column. */
	.ks-band {
		padding: 5.5rem 0;
		border-top: 1px solid var(--line);
	}
	.ks-wrap {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* ---------- HERO ---------- */
	.ks-hero-band {
		border-top: none;
		padding: 4.5rem 0 4rem;
		text-align: center;
		background:
			radial-gradient(900px 380px at 50% -10%, rgba(137, 15, 188, 0.1), transparent 70%);
	}
	.ks-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px rgba(137, 15, 188, 0.7);
		animation: ks-pulse 2s infinite;
	}
	@keyframes ks-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.35; }
	}
	.ks-hero h1 {
		font-size: clamp(2.5rem, 6vw, 4.4rem);
		line-height: 1.04;
		max-width: 16ch;
		margin: 1.4rem auto 1.3rem;
	}
	.ks-hl {
		background: linear-gradient(120deg, var(--accent), var(--accent-dark));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.ks-sub {
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		color: var(--ink-soft);
		max-width: 60ch;
		margin: 0 auto 2rem;
	}
	.ks-sub b {
		color: var(--ink);
		font-weight: 600;
	}
	.ks-cta-row {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 1.6rem;
	}
	.ks-trust {
		list-style: none;
		display: flex;
		gap: 1.4rem;
		justify-content: center;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		font-family: var(--ks-mono);
		font-size: 0.82rem;
		color: var(--ink-muted);
	}
	.ks-trust li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.ks-trust svg {
		width: 15px;
		height: 15px;
		color: var(--accent);
	}

	/* ---------- HERO VISUAL ---------- */
	.ks-stage {
		max-width: 1000px;
		margin: 3.5rem auto 0;
		text-align: left;
	}
	.ks-stage-frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		padding: 1.8rem;
		box-shadow: var(--shadow-soft);
	}
	.ks-stage-frame::before {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 0%, var(--accent-soft), transparent 60%);
		pointer-events: none;
	}
	.ks-stage-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	.ks-panel {
		position: relative;
		z-index: 2;
		background: var(--ks-surface-2);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 1rem 1rem 0.85rem;
	}
	.ks-panel-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--ks-mono);
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-bottom: 0.8rem;
	}
	.ks-tagged {
		margin-left: auto;
		color: var(--accent);
		text-transform: none;
		letter-spacing: 0.04em;
	}
	.ks-kv {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--ks-mono);
		font-size: 0.78rem;
		padding: 0.45rem 0;
		border-bottom: 1px dashed var(--line);
	}
	.ks-kv:last-child { border-bottom: none; }
	.ks-kv .k { color: var(--ink-muted); }
	.ks-kv .v { color: var(--ink); }
	.ks-kv .secret { color: var(--accent); letter-spacing: 0.1em; }

	/* hub */
	.ks-hub {
		position: relative;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		padding: 0 1rem;
	}
	.ks-hub-core {
		width: 74px;
		height: 74px;
		border-radius: 18px;
		display: grid;
		place-items: center;
		color: var(--surface);
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		box-shadow: 0 0 0 6px rgba(137, 15, 188, 0.08), 0 12px 30px rgba(137, 15, 188, 0.28);
