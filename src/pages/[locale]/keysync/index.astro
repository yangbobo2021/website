	.ks-sec-head { margin-bottom: 3rem; }
	.ks-center { text-align: center; }
	.ks-mx-auto { margin-left: auto; margin-right: auto; }

	/* ---------- PROBLEM ---------- */
	.ks-problem-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3.4rem;
		align-items: center;
	}
	.ks-pain-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin: 1.4rem 0 0;
		padding: 0;
	}
	.ks-pain-list li {
		display: grid;
		grid-template-columns: 26px minmax(0, 1fr);
		column-gap: 0.8rem;
		align-items: flex-start;
		color: var(--ink-soft);
		font-size: 1rem;
		line-height: 1.58;
	}
	.ks-pain-list li::before {
		content: "!";
		flex-shrink: 0;
		width: 26px;
		height: 26px;
		border-radius: var(--radius-sm);
		display: grid;
		place-items: center;
		margin-top: 0.08rem;
		background: rgba(190, 71, 56, 0.075);
		border: 1px solid rgba(190, 71, 56, 0.16);
		color: #b24a3a;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1;
	}
	.ks-pain-list b { color: var(--ink); font-weight: 600; }
	.ks-drift-visual {
		position: relative;
		border: none;
		border-radius: var(--radius-lg);
		overflow: visible;
	}
	.ks-drift-devices {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.ks-device-card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		padding: 1.5rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	/* Synced card - neutral styling, Key badge conveys "new" */
	.ks-card-synced {
		border-color: var(--line);
	}
	/* Stale card - neutral */
	.ks-card-stale {
		border-color: var(--line);
		opacity: 0.85;
	}
	.ks-device-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}
	.ks-device-info {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}
	.ks-device-icon {
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(137, 15, 188, 0.08);
		border-radius: 6px;
	}
	.ks-device-icon svg {
		width: 20px;
		height: 20px;
		color: var(--accent);
	}
	.ks-device-name {
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--ink);
	}
	.ks-device-status {
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.ks-status-icon {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
	}
	.ks-status-just-updated {
		color: #2d7d46;
	}
	.ks-status-not-synced {
		color: var(--ink-muted);
	}
	.ks-device-key {
		display: flex;
		align-items: center;
	}
	.ks-status-synced {
		color: var(--accent);
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.ks-status-synced svg {
		width: 16px;
		height: 16px;
	}
	.ks-status-not-synced {
		color: var(--ink-muted);
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.ks-status-not-synced svg {
		width: 16px;
		height: 16px;
	}
	.ks-status-stale {
		color: var(--ink-muted);
	}
	.ks-device-rows {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.ks-device-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.ks-tool-name {
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--ink-soft);
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.ks-tool-key {
		font-family: var(--font-display);
		font-size: 0.6rem;
		font-weight: 600;
		padding: 0.12rem 0.35rem;
		border-radius: 4px;
		letter-spacing: 0.02em;
	}
	.ks-key-new {
		background: rgba(137, 15, 188, 0.08);
		color: var(--accent);
	}
	.ks-key-old {
		background: rgba(21, 22, 26, 0.06);
		color: var(--ink-soft);
	}
	.ks-tool-status {
		font-family: var(--font-display);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		font-weight: 500;
	}
	.ks-status-connected {
		color: #2d7d46;
	}
	.ks-status-disconnected {
		color: var(--ink-muted);
	}
	.ks-row-divider {
		height: 1px;
		background: var(--line);
	}

	@media (max-width: 640px) {
		/* Stack cards vertically on mobile */
	}

	/* ---------- HOW IT WORKS ---------- */
	.ks-steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.4rem;
	}
	.ks-step {
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-lg);
		padding: 1.7rem 1.5rem;
		box-shadow: none;
		transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
	}
	.ks-step:hover {
		transform: translateY(-3px);
		border-color: rgba(137, 15, 188, 0.35);
		background: var(--surface);
	}
	.ks-step-n {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		margin-bottom: 1.1rem;
		border-radius: var(--radius-sm);
		border: 1px solid rgba(137, 15, 188, 0.18);
		background: var(--surface);
		font-family: var(--ks-mono);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--accent);
	}
	.ks-step h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
	.ks-step p { color: var(--ink-soft); font-size: 0.96rem; margin: 0; }
	.ks-step p code {
		font-family: var(--ks-mono);
		font-size: 0.85em;
		color: var(--ink);
		background: rgba(21, 22, 26, 0.06);
		padding: 1px 6px;
		border-radius: 6px;
	}

	.ks-guarantees {
		display: grid;
		grid-template-columns: minmax(14rem, 0.68fr) minmax(0, 1.32fr);
		gap: 2rem;
		margin-top: 2.4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--ks-line);
	}
	.ks-guarantees-head p {
		max-width: 28ch;
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.98rem;
	}
	.ks-sub-eyebrow {
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent-dark);
		margin-bottom: 0.75rem;
	}
	.ks-guarantee-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem 1.6rem;
		margin: 0;
		padding: 0;
	}
	.ks-guarantee-list li {
		padding-top: 0.9rem;
		border-top: 1px solid var(--ks-line);
	}
	.ks-guarantee-list li:nth-child(1),
	.ks-guarantee-list li:nth-child(2) {
		padding-top: 0;
		border-top: none;
	}
	.ks-guarantee-list h3 {
		margin-bottom: 0.35rem;
		font-size: 1.05rem;
	}
	.ks-guarantee-list p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.94rem;
		line-height: 1.55;
	}

	/* ---------- SECURITY ---------- */
	.ks-sec-split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3.5rem;
		align-items: center;
	}
	.ks-check-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		margin: 1.6rem 0 0;
		padding: 0;
	}
	.ks-check-list li {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
	}
	.ks-ck {
		flex-shrink: 0;
		width: 26px;
		height: 26px;
		border-radius: var(--radius-sm);
		display: grid;
		place-items: center;
		background: var(--ks-accent-soft);
		border: 1px solid rgba(137, 15, 188, 0.16);
		color: var(--accent);
	}
	.ks-ck svg { width: 14px; height: 14px; }
	.ks-check-list .t { font-weight: 600; font-size: 1.04rem; color: var(--ink); margin-bottom: 0.15rem; }
	.ks-check-list .d { color: var(--ink-soft); font-size: 0.94rem; }

	.ks-imgslot {
		overflow: hidden;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--surface);
		box-shadow: var(--ks-shadow-card);
	}
	.ks-shot {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}

	/* ---------- FAQ ---------- */
	.ks-faq {
		max-width: 760px;
		margin: 0 auto;
	}
	.ks-faq details {
		border-bottom: 1px solid var(--ks-line);
		padding: 0.4rem 0;
	}
	.ks-faq summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 0.25rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.08rem;
		color: var(--ink);
	}
	.ks-faq summary::-webkit-details-marker { display: none; }
	.ks-plus {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		display: grid;
		place-items: center;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-sm);
		color: var(--accent);
	}
	.ks-plus svg { width: 14px; height: 14px; }
	.ks-plus-bar { transition: opacity 0.2s ease; }
	.ks-faq details[open] .ks-plus-bar { opacity: 0; }
	.ks-faq details p {
		margin: 0;
		padding: 0 0.25rem 1.2rem;
		color: var(--ink-soft);
		font-size: 0.98rem;
		max-width: 64ch;
	}

	/* ---------- CONTACT QR ---------- */
	.ks-contact-qr-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2.4rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		padding: clamp(2rem, 4vw, 3rem);
		box-shadow: var(--ks-shadow-card);
	}
	.ks-contact-qr-title {
		max-width: 18ch;
		margin: 0;
		font-size: clamp(1.65rem, 3vw, 2.35rem);
		font-weight: 600;
		line-height: 1.14;
		letter-spacing: 0;
		color: var(--ink);
	}
	.ks-contact-qr-copy p {
		max-width: 42ch;
		margin: 1rem 0 0;
		color: var(--ink-soft);
		font-size: 1.02rem;
		line-height: 1.65;
	}
	.ks-contact-qr-figure {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: 0.75rem;
	}
	.ks-contact-qr-frame {
		width: 220px;
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		padding: 0.65rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: #fff;
		box-shadow: 0 10px 24px rgba(21, 22, 26, 0.045);
	}
	.ks-contact-qr-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}
	.ks-contact-qr-figure figcaption {
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-align: center;
	}

	.ks-download-files {
		border-top: none;
	}
	.ks-download-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.ks-download-choice {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--surface);
		padding: 1.4rem;
		box-shadow: var(--ks-shadow-card);
	}
	.ks-download-platform {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		font-weight: 600;
		text-align: center;
		color: var(--ink);
	}
	.ks-download-desc {
		margin: 0 0 1.25rem;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.5;
		text-align: center;
	}
	.ks-download-actions {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.ks-download-entry {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-sm);
		background: #fffefb;
		color: var(--ink);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
		transition: border-color 0.15s ease, background-color 0.15s ease, outline 0.15s ease;
	}
	.ks-download-entry:hover,
	.ks-download-entry:focus-visible {
		border-color: rgba(137, 15, 188, 0.3);
		background: rgba(137, 15, 188, 0.03);
	}
	.ks-download-entry:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.ks-download-entry span {
		flex: 1;
	}
	.ks-download-icon {
		flex-shrink: 0;
		color: var(--accent);
		transition: color 0.15s ease;
	}
	.ks-download-entry:hover .ks-download-icon {
		color: var(--accent-dark, var(--accent));
	}
	.ks-download-secondary {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.ks-download-footer {
		margin: 1.5rem 0 0;
		text-align: center;
		color: var(--ink-muted);
		font-family: var(--ks-mono);
		font-size: 0.82rem;
	}

	/* ---------- FINAL CTA ---------- */
	.ks-final {
		text-align: center;
	}
	.ks-final-card {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		padding: 4rem 2.5rem;
		box-shadow: var(--ks-shadow-float);
	}
	.ks-final-card h2 {
		max-width: 16ch;
		margin: 0 auto 1.1rem;
		font-size: clamp(2rem, 4.4vw, 3.1rem);
		font-weight: 600;
		letter-spacing: -0.018em;
	}
	.ks-final-card p {
		max-width: 50ch;
		margin: 0 auto 2rem;
		color: var(--ink-soft);
		font-size: 1.1rem;
	}
	.ks-run {
		margin-top: 1.4rem;
		font-family: var(--ks-mono);
		font-size: 0.82rem;
		color: var(--ink-muted);
	}

	/* ---------- MOBILE CTA (< 1024px) ---------- */
	.ks-mobile-cta {
		display: none;
		max-width: 440px;
		margin: 0 auto 2rem;
		padding: 1.4rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: 0 8px 32px rgba(21, 22, 26, 0.06);
		text-align: left;
	}
	.ks-mobile-cta-head {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.6rem;
	}
	.ks-mobile-cta-icon {
		flex-shrink: 0;
		color: var(--accent);
	}
	.ks-mobile-cta-head h3 {
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
		color: var(--ink);
	}
	.ks-mobile-cta-desc {
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--ink-soft);
		margin: 0 0 1.1rem;
	}
	.ks-mobile-url-display {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.4rem;
		padding: 0.4rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--ks-surface-2);
	}
	.ks-mobile-url {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 0.55rem 0.75rem;
		font-family: var(--ks-mono);
		font-size: 0.82rem;
		color: var(--ink);
		letter-spacing: -0.01em;
		word-break: break-all;
		overflow-wrap: anywhere;
		min-width: 0;
	}
	.ks-mobile-copy-btn-primary {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0.55rem 1.05rem;
		border: none;
		border-radius: var(--radius-sm);
		background: var(--accent);
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		transition: background-color 0.2s ease, transform 0.15s ease;
	}
	.ks-mobile-copy-btn-primary:hover {
		background: var(--accent-dark);
	}
	.ks-mobile-copy-btn-primary:active {
		transform: scale(0.97);
	}
	.ks-mobile-copy-btn-primary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.ks-mobile-copy-btn-primary svg {
		flex-shrink: 0;
	}
	.ks-mobile-copy-btn-primary.ks-copy-success {
		background: #2d7d46;
	}

	/* ---------- MOBILE 3-STEP OVERVIEW ---------- */
	.ks-mobile-steps {
		display: none;
		padding: 3rem 0;
		background: var(--ks-surface-2);
		border-top: 1px solid var(--ks-line);
	}
	.ks-mobile-steps-title {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0 0 1.4rem;
		color: var(--ink);
		text-align: center;
	}
	.ks-mobile-steps-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.ks-mobile-step {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 1rem;
		background: var(--surface);
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
	}
	.ks-mobile-step-num {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border-radius: var(--radius-sm);
		background: rgba(137, 15, 188, 0.08);
		border: 1px solid rgba(137, 15, 188, 0.15);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent);
	}
	.ks-mobile-step-content {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.ks-mobile-step-label {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--ink);
	}
	.ks-mobile-step-desc {
		font-size: 0.85rem;
		color: var(--ink-soft);
		line-height: 1.5;
	}

	/* ---------- FINAL MOBILE CTA ---------- */
	.ks-final-mobile-cta {
		display: none;
		margin-top: 1.5rem;
	}
	.ks-final-copy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-width: 180px;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		-webkit-user-select: none;
		user-select: none;
	}
