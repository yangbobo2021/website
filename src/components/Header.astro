---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>

import { SITE_TITLE } from '../consts';
import Wordmark from '../assets/brand/wordmark-color-light-bg.png';
import HeaderLink from './HeaderLink.astro';
import {
	DEFAULT_LOCALE,
	HTML_LANG,
	LOCALE_LABELS,
	LOCALES,
	localeHref,
	type Locale,
} from '../i18n/config';
import { isRouteAvailable } from '../i18n/availability';
import { useTranslations } from '../i18n/messages';

interface Props {
	lang?: Locale;
	/**
	 * Map of locale → URL on the current page. Locales absent from this map are
	 * rendered as inert <span> in the switcher (translation unavailable).
	 */
	translations?: Partial<Record<Locale, string>>;
	/** Show mobile header CTA (only on /keysync pages) */
	hasKeysync?: boolean;
}

const { lang, translations, hasKeysync } = Astro.props;
const activeLocale: Locale = lang ?? DEFAULT_LOCALE;
const t = useTranslations(activeLocale).nav;

type NavItem = { path: string; label: string };
const navItems: NavItem[] = [
	{ path: '/', label: t.home },
	{ path: '/engineering/', label: t.engineering },
];
const productMenuItems = t.productMenuItems;
// The logo is a brand anchor that should always lead somewhere usable; if the
// active locale has no home, fall back to the default-locale root rather than
// linking to a page that does not exist. Text "Home" nav still follows the
// strict availability rule below.
const homeHref = isRouteAvailable('/', activeLocale)
	? localeHref(activeLocale, '/')
	: localeHref(DEFAULT_LOCALE, '/');
---

<header class="site-header">
		<nav>
			<div class="nav-left">
				<a class="logo" href={homeHref} aria-label={SITE_TITLE}>
					<img
						src={Wordmark.src}
						width={Wordmark.width}
						height={Wordmark.height}
						alt={`${SITE_TITLE} wordmark`}
						loading="eager"
						decoding="async"
					/>
				</a>
			</div>
			<div class="nav-center">
				<div class="internal-links" aria-label="Primary navigation">
					{navItems.map((item) =>
						isRouteAvailable(item.path, activeLocale) ? (
							<HeaderLink href={localeHref(activeLocale, item.path)}>{item.label}</HeaderLink>
						) : (
							<span class="nav-unavailable" aria-disabled="true" title={t.unavailableTitle}>
								{item.label}
							</span>
						),
					)}
					<div class="nav-dropdown" aria-label="Product menu">
						<button
							type="button"
							class="nav-dropdown-trigger"
							aria-haspopup="true"
							aria-expanded="false"
						>
							{t.product}
							<svg class="nav-dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>
						<ul class="nav-dropdown-menu" role="menu">
							{productMenuItems.map((item) => (
								<li role="none">
									<a href={item.href} role="menuitem">{item.label}</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
			<div class="nav-right">
				<div class="utility-links">
					<div class="lang-switcher" aria-label={t.languageLabel}>
						{LOCALES.map((locale, index) => {
							const url = translations?.[locale];
							const sep =
								index > 0 ? (
									<span class="lang-sep" aria-hidden="true">/</span>
								) : null;
							if (locale === activeLocale) {
								return (
									<>
										{sep}
										<span class="lang-active" aria-current="page" lang={HTML_LANG[locale]}>
											{LOCALE_LABELS[locale]}
										</span>
									</>
								);
							}
							if (url) {
								return (
									<>
										{sep}
										<a href={url} hreflang={HTML_LANG[locale]} lang={HTML_LANG[locale]}>
											{LOCALE_LABELS[locale]}
										</a>
									</>
								);
							}
							return (
								<>
									{sep}
									<span
										class="lang-unavailable"
										aria-disabled="true"
										title={t.unavailableTitle}
										lang={HTML_LANG[locale]}
									>
										{LOCALE_LABELS[locale]}
									</span>
								</>
							);
						})}
					</div>
					<div class="social-links" aria-label="Social links">
						<a href="https://github.com/sublang-ai" target="_blank" rel="noopener noreferrer">
							<span class="sr-only">SubLang on GitHub</span>
							<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
								><path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								></path></svg
							>
						</a>
						<a href="https://x.com/sublang_ai" target="_blank" rel="noopener noreferrer">
							<span class="sr-only">SubLang on X</span>
							<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
								><path
									fill="currentColor"
									d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
								></path></svg
							>
						</a>
					</div>
				</div>
				<div class="mobile-header-actions">
					<a href="#mobile-cta" class={`mobile-header-cta ${hasKeysync ? 'has-keysync' : ''}`}>Download</a>
					<button
						type="button"
						class="mobile-menu-toggle"
						aria-label={t.menuOpen}
						aria-expanded="false"
						aria-controls="mobile-menu-overlay"
					>
						<span class="mobile-menu-toggle-bar" aria-hidden="true"></span>
						<span class="mobile-menu-toggle-bar" aria-hidden="true"></span>
						<span class="mobile-menu-toggle-bar" aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</nav>
	</header>

	<div class="mobile-menu-overlay" id="mobile-menu-overlay" data-open="false" aria-hidden="true">
		<div class="mobile-menu-panel" role="dialog" aria-label={t.menuOpen}>
				<button class="mobile-menu-close" type="button" aria-label="Close menu">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			<div class="mobile-menu-nav">
				{navItems.map((item) =>
					isRouteAvailable(item.path, activeLocale) ? (
						<a
							href={localeHref(activeLocale, item.path)}
							class="mobile-menu-link"
						>
							{item.label}
						</a>
					) : (
						<span class="mobile-menu-link mobile-menu-link-disabled" aria-disabled="true">
							{item.label}
						</span>
					),
				)}
			</div>
			<div class="mobile-menu-section">
				<div class="mobile-menu-eyebrow">{t.product}</div>
				<ul class="mobile-menu-product">
					{productMenuItems.map((item) => (
						<li>
							<a href={item.href} class="mobile-menu-link mobile-menu-link-sub">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div class="mobile-menu-footer">
				<div class="mobile-menu-lang" aria-label={t.languageLabel}>
					{LOCALES.map((locale, index) => {
						const url = translations?.[locale];
						if (locale === activeLocale) {
							return (
								<span class="mobile-menu-lang-active" aria-current="page" lang={HTML_LANG[locale]}>
									{LOCALE_LABELS[locale]}
								</span>
							);
						}
						if (url) {
							return (
								<a
									href={url}
									class="mobile-menu-lang-link"
									hreflang={HTML_LANG[locale]}
									lang={HTML_LANG[locale]}
								>
									{LOCALE_LABELS[locale]}
								</a>
							);
						}
						return (
							<span
								class="mobile-menu-lang-disabled"
								aria-disabled="true"
								lang={HTML_LANG[locale]}
							>
								{LOCALE_LABELS[locale]}
							</span>
						);
					})}
				</div>
				<div class="mobile-menu-social" aria-label="Social links">
					<a href="https://github.com/sublang-ai" target="_blank" rel="noopener noreferrer" class="mobile-menu-social-link">
						<span class="sr-only">SubLang on GitHub</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
							><path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path></svg
						>
					</a>
					<a href="https://x.com/sublang_ai" target="_blank" rel="noopener noreferrer" class="mobile-menu-social-link">
						<span class="sr-only">SubLang on X</span>
						<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
							><path
								fill="currentColor"
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							></path></svg
						>
					</a>
				</div>
			</div>
		</div>
	</div>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 2rem;
		background: rgba(247, 244, 239, 0.8);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
	}
	.nav-left {
		display: flex;
		align-items: center;
	}
	.nav-center {
		display: flex;
		align-items: center;
		justify-content: center;
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		border-bottom: none;
	}
	.logo img {
		height: 26px;
		width: auto;
		border-radius: 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.internal-links a {
		border-bottom: none;
		color: var(--ink-muted);
	}
	.internal-links a.active {
		color: var(--ink);
	}
	.internal-links .nav-unavailable {
		color: var(--ink-muted);
		opacity: 0.4;
		cursor: not-allowed;
	}
	/* Product dropdown menu */
	.nav-dropdown {
		position: relative;
		display: inline-flex;
		align-items: center;
	}
	.nav-dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		cursor: pointer;
		transition: color 0.2s ease;
	}
	.nav-dropdown-trigger:hover {
		color: var(--ink);
	}
	.nav-dropdown-arrow {
		transition: transform 0.2s ease;
	}
	.nav-dropdown:hover .nav-dropdown-arrow,
	.nav-dropdown[data-open="true"] .nav-dropdown-arrow {
		transform: rotate(180deg);
	}
	.nav-dropdown-menu {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		margin-top: 0.5rem;
		min-width: 140px;
		padding: 0.5rem 0;
		list-style: none;
		background: rgba(247, 244, 239, 0.96);
		backdrop-filter: blur(18px);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		box-shadow: 0 8px 24px rgba(21, 22, 26, 0.08);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.2s ease, visibility 0.2s ease;
		z-index: 20;
	}
	.nav-dropdown:hover .nav-dropdown-menu,
	.nav-dropdown[data-open="true"] .nav-dropdown-menu {
		opacity: 1;
		visibility: visible;
	}
	.nav-dropdown-menu li {
		margin: 0;
	}
	.nav-dropdown-menu a {
		display: block;
		padding: 0.5rem 1rem;
		border-bottom: none;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	.nav-dropdown-menu a:hover,
	.nav-dropdown-menu a:focus-visible {
		color: var(--ink);
		background: rgba(21, 22, 26, 0.03);
	}
	.nav-dropdown-menu a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	.nav-center {
		display: none;
	}
	.mobile-header-actions {
		display: none;
	}
	.utility-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.lang-switcher {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.lang-switcher a {
		border-bottom: none;
		color: var(--ink-muted);
		transition: color 0.2s ease;
	}
	.lang-switcher a:hover {
		color: var(--accent);
	}
	.lang-switcher .lang-active {
		color: var(--ink);
	}
	.lang-switcher .lang-unavailable {
		color: var(--ink-muted);
		opacity: 0.4;
		cursor: not-allowed;
	}
	.lang-switcher .lang-sep {
		color: var(--ink-muted);
		opacity: 0.5;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social-links a {
		display: inline-flex;
		color: var(--ink-muted);
		border-bottom: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
		transform: translateY(-1px);
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.utility-links {
			gap: 0.75rem;
		}
		.site-header {
			padding: 0 1.2rem;
		}
		.logo img {
			height: 22px;
		}
		.internal-links {
			gap: 1rem;
			letter-spacing: 0.16em;
		}
		.lang-switcher {
			letter-spacing: 0.14em;
			gap: 0.4rem;
		}
		.nav-dropdown-menu {
			left: 0;
			transform: none;
		}
	}

	/* Mobile menu toggle (hamburger) */
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		margin-left: auto;
		padding: 0;
		border: none;
		background: transparent;
		cursor: pointer;
		gap: 5px;
	}
	/* Mobile header CTA - hidden on desktop, shown on mobile */
	.mobile-header-cta {
		display: none;
	}
	.mobile-menu-toggle-bar {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--ink-muted);
		border-radius: 2px;
		transition: transform 0.25s ease, opacity 0.25s ease;
		transform-origin: center;
	}
	.mobile-menu-toggle:hover .mobile-menu-toggle-bar {
		background: var(--ink);
	}
	.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle-bar:nth-child(2) {
		opacity: 0;
	}
	.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* Mobile menu overlay */
	.mobile-menu-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 1000;
		background: rgba(21, 22, 26, 0.4);
		opacity: 0;
		transition: opacity 0.25s ease;
	}
	.mobile-menu-overlay[data-open="true"] {
		display: block;
		opacity: 1;
	}
	.mobile-menu-panel {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(320px, 85vw);
		padding: 4.5rem 1.5rem 2rem;
		background: var(--surface);
		border-left: 1px solid var(--line);
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.mobile-menu-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--ink-muted);
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	.mobile-menu-close:hover {
		color: var(--ink);
		background: rgba(21, 22, 26, 0.06);
	}
	.mobile-menu-close:active {
		background: rgba(21, 22, 26, 0.1);
	}
	.mobile-menu-close:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.mobile-menu-nav {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.mobile-menu-link {
		position: relative;
		display: block;
		padding: 0.75rem 0.5rem;
		border-bottom: none;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: color 0.2s ease, background-color 0.2s ease;
		border-radius: var(--radius-sm);
	}
	.mobile-menu-link:hover,
	.mobile-menu-link:focus-visible {
		color: var(--ink);
		background: rgba(21, 22, 26, 0.04);
	}
	.mobile-menu-link-disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	/* Active state for current page in mobile menu */
	.mobile-menu-link.active {
		color: var(--accent);
		font-weight: 600;
		background: rgba(137, 15, 188, 0.06);
	}
	.mobile-menu-link.active::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--accent);
		border-radius: 2px;
	}
	.mobile-menu-section {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}
	.mobile-menu-eyebrow {
		font-family: var(--font-display);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-bottom: 0.5rem;
	}
	.mobile-menu-product {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.mobile-menu-link-sub {
		font-size: 0.9rem;
		letter-spacing: 0.08em;
	}
	.mobile-menu-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.mobile-menu-lang {
		display: flex;
		gap: 0.75rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.mobile-menu-lang-link {
		border-bottom: none;
		color: var(--ink-muted);
		transition: color 0.2s ease;
	}
	.mobile-menu-lang-link:hover {
		color: var(--accent);
	}
	.mobile-menu-lang-active {
		color: var(--ink);
	}
	.mobile-menu-lang-disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.mobile-menu-social {
		display: flex;
		gap: 1rem;
	}
	.mobile-menu-social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-bottom: none;
		color: var(--ink-muted);
		background: rgba(21, 22, 26, 0.04);
		border-radius: var(--radius-sm);
		transition: color 0.2s ease, background-color 0.2s ease;
	}
	.mobile-menu-social-link:hover {
		color: var(--accent);
		background: rgba(137, 15, 188, 0.08);
	}

	/* Mobile nav visibility (720px breakpoint) */
	@media (max-width: 719px) {
		.nav-center {
			display: none;
		}
		.utility-links {
			display: none;
		}
		.mobile-header-actions {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}
		.mobile-menu-toggle {
			display: flex;
		}
		/* Only show CTA on /keysync pages */
		.mobile-header-cta.has-keysync {
			display: inline-flex;
			align-items: center;
			padding: 0.4rem 0.7rem;
			margin-right: 0.4rem;
			border-radius: var(--radius-sm);
			background: var(--accent);
			color: #fff;
			font-family: var(--font-display);
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.03em;
			text-decoration: none;
			transition: transform 0.15s ease, box-shadow 0.15s ease;
			-webkit-tap-highlight-color: transparent;
			-webkit-user-select: none;
			user-select: none;
		}
		.mobile-header-cta.has-keysync:hover {
			box-shadow: 0 0 0 1px var(--accent);
		}
		.mobile-header-cta.has-keysync:active {
			transform: scale(0.96);
		}
		.mobile-header-cta.has-keysync:focus,
		.mobile-header-cta.has-keysync:focus-visible {
			outline: none;
		}
	}
</style>
<script>
	// Keyboard navigation for product dropdown
	document.addEventListener('DOMContentLoaded', () => {
		const dropdowns = document.querySelectorAll('.nav-dropdown');
		dropdowns.forEach((dropdown) => {
			const trigger = dropdown.querySelector('.nav-dropdown-trigger');
			const menu = dropdown.querySelector('.nav-dropdown-menu');
			const items = menu?.querySelectorAll('a');

			trigger?.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					const isOpen = dropdown.getAttribute('data-open') === 'true';
					dropdown.setAttribute('data-open', isOpen ? 'false' : 'true');
					trigger.setAttribute('aria-expanded', !isOpen);
					if (!isOpen && items && items.length > 0) {
						items[0].focus();
					}
				} else if (e.key === 'ArrowDown' && items && items.length > 0) {
					e.preventDefault();
					items[0].focus();
				}
			});

			items?.forEach((item, index) => {
				item.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						dropdown.setAttribute('data-open', 'false');
						trigger?.setAttribute('aria-expanded', 'false');
						trigger?.focus();
					} else if (e.key === 'ArrowDown' && index < items.length - 1) {
						e.preventDefault();
						items[index + 1].focus();
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						if (index > 0) {
							items[index - 1].focus();
						} else {
							trigger?.focus();
						}
					}
				});
			});

			// Close on click outside
			document.addEventListener('click', (e) => {
				if (!dropdown.contains(e.target as Node)) {
					dropdown.setAttribute('data-open', 'false');
					trigger?.setAttribute('aria-expanded', 'false');
				}
			});
		});

		// Mobile menu toggle
		const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
		const mobileMenuOverlay = document.querySelector('.mobile-menu-overlay');
		const mobileMenuClose = document.querySelector('.mobile-menu-close');
		let isMenuOpen = false;

		function openMobileMenu() {
			if (!mobileMenuOverlay || !mobileMenuToggle) return;
			isMenuOpen = true;
			mobileMenuOverlay.setAttribute('data-open', 'true');
			mobileMenuOverlay.setAttribute('aria-hidden', 'false');
			mobileMenuToggle.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			// Focus close button
			mobileMenuClose?.focus();
		}

		function closeMobileMenu() {
			if (!mobileMenuOverlay || !mobileMenuToggle) return;
			isMenuOpen = false;
			mobileMenuOverlay.setAttribute('data-open', 'false');
			mobileMenuOverlay.setAttribute('aria-hidden', 'true');
			mobileMenuToggle.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
		}

		mobileMenuToggle?.addEventListener('click', () => {
			if (isMenuOpen) {
				closeMobileMenu();
			} else {
				openMobileMenu();
			}
		});

		// Close button handler
		mobileMenuClose?.addEventListener('click', () => {
			if (isMenuOpen) {
				closeMobileMenu();
				mobileMenuToggle?.focus();
			}
		});

		// Close on overlay click
		mobileMenuOverlay?.addEventListener('click', (e) => {
			if (e.target === mobileMenuOverlay) {
				closeMobileMenu();
			}
		});

		// Close on Escape
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isMenuOpen) {
				closeMobileMenu();
				mobileMenuToggle?.focus();
			}
		});

		// Handle responsive: close menu when resizing to desktop
		let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				if (window.innerWidth >= 720 && isMenuOpen) {
					closeMobileMenu();
				}
			}, 100);
		});

		// Smooth scroll for mobile header CTA
		const mobileHeaderCta = document.querySelector('.mobile-header-cta');
		mobileHeaderCta?.addEventListener('click', (e) => {
			e.preventDefault();
			const target = document.querySelector('#mobile-cta');
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
			// Remove focus to prevent any persistent browser focus styling
			(mobileHeaderCta as HTMLElement)?.blur();
		});

		// Set mobile menu active state based on current path
		const currentPath = window.location.pathname;
		const menuLinks = document.querySelectorAll('.mobile-menu-link');
		menuLinks.forEach((link) => {
			const href = link.getAttribute('href');
			if (href) {
				try {
					const linkPath = new URL(href, window.location.origin).pathname;
					// Match exact path or parent path
					if (linkPath === currentPath || (currentPath.startsWith(linkPath) && linkPath !== '/')) {
						link.classList.add('active');
					}
				} catch (e) {
					// Ignore invalid URLs
				}
			}
		});
	});
</script>
