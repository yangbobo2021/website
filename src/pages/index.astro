import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomePageBody from '../components/pages/HomePageBody.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { DEFAULT_LOCALE, HTML_LANG } from '../i18n/config';

const translations = {
	en: '/',
	zh: '/zh/',
} as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([locale, path]) => ({
		locale,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang={HTML_LANG[DEFAULT_LOCALE]}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			lang={DEFAULT_LOCALE}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={DEFAULT_LOCALE} translations={translations} />
		<HomePageBody lang={DEFAULT_LOCALE} />
		<Footer lang={DEFAULT_LOCALE} />
	</body>
</html>
