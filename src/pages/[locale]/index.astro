import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import HomePageBody from '../../components/pages/HomePageBody.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { HTML_LANG, type Locale, localeHref } from '../../i18n/config';
import { useTranslations } from '../../i18n/messages';

// Per-page locale filter: only the non-default locales listed here get a
// /<locale>/ home. Adding a new locale to LOCALES does NOT auto-create one;
// the translation must be opted in here so visitors never land on a
// /<locale>/ page filled with default-locale fallback content.
export async function getStaticPaths() {
	const availableNonDefaultLocales: readonly Locale[] = ['zh'];
	return availableNonDefaultLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const translations = {
	en: localeHref('en', '/'),
	zh: localeHref('zh', '/'),
} as const;
const alternates = (Object.entries(translations) as Array<[Locale, string]>).map(([loc, path]) => ({
	locale: loc,
	href: new URL(path, Astro.site).toString(),
}));

// Title and description are language-specific; reuse SITE_* for the default and
// pull a translated description here when available. SITE_TITLE is the brand
// (unchanged across locales).
const t = useTranslations(locale);
const description = t.home.description ?? SITE_DESCRIPTION;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={description}
			lang={locale}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={locale} translations={translations} />
		<HomePageBody lang={locale} />
		<Footer lang={locale} />
	</body>
</html>
