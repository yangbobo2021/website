// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>

import ConsentBanner from './ConsentBanner.astro';
import { DEFAULT_LOCALE, type Locale, localeHref } from '../i18n/config';
import { isRouteAvailable } from '../i18n/availability';
import { useTranslations } from '../i18n/messages';

interface Props {
	lang?: Locale;
}

const { lang } = Astro.props;
const activeLocale: Locale = lang ?? DEFAULT_LOCALE;
const t = useTranslations(activeLocale);
const nav = t.nav;
const f = t.footer;
const today = new Date();
const engineeringAvailable = isRouteAvailable('/engineering/', activeLocale);
const blogAvailable = isRouteAvailable('/blog/', activeLocale);
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-brand">
			<div class="eyebrow">{f.orgName}</div>
			<p class="muted">{f.tagline}</p>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="https://github.com/sublang-ai" target="_blank" rel="noopener noreferrer">{f.linkGitHub}</a>
			<a href="https://x.com/sublang_ai" target="_blank" rel="noopener noreferrer">{f.linkX}</a>
			{engineeringAvailable ? (
				<a href={localeHref(activeLocale, '/engineering/')}>{f.linkEngineering}</a>
			) : (
				<span class="link-unavailable" aria-disabled="true" title={nav.unavailableTitle}>
					{f.linkEngineering}
				</span>
			)}
			{blogAvailable ? (
				<a href={localeHref(activeLocale, '/blog/')}>{f.linkBlog}</a>
			) : (
				<span class="link-unavailable" aria-disabled="true" title={nav.unavailableTitle}>
					{f.linkBlog}
				</span>
			)}
		</nav>
		<div class="footer-meta">{f.copyright(today.getFullYear())}</div>
	</div>
</footer>
<ConsentBanner lang={activeLocale} />
<style>
	.site-footer {
		padding: 3.5rem 2rem 4rem;
		border-top: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.65);
	}
	.footer-shell {
		width: min(100%, 58rem);
		max-width: var(--grid-max);
		margin: 0 auto;
		display: grid;
		gap: 1.75rem clamp(2.5rem, 6vw, 5.5rem);
		grid-template-columns: minmax(0, 42rem) minmax(10rem, 12rem);
		grid-template-areas:
			'brand links'
			'meta meta';
		align-items: center;
		justify-content: center;
	}
	.footer-brand {
		grid-area: brand;
		max-width: 42rem;
	}
	.footer-brand .muted {
		margin: 0.55rem 0 0;
	}
	.footer-links {
		grid-area: links;
		justify-self: start;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-family: var(--font-display);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-size: 0.8rem;
	}
	.footer-links a {
		border-bottom: none;
		color: var(--ink-muted);
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-links .link-unavailable {
		color: var(--ink-muted);
		opacity: 0.4;
		cursor: not-allowed;
	}
	.footer-meta {
		grid-area: meta;
		margin-top: 0.45rem;
		color: var(--ink-muted);
		font-size: 0.85rem;
	}
	@media (max-width: 960px) {
		.footer-shell {
			width: 100%;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 1.75rem 3rem;
		}
	}
	@media (max-width: 720px) {
		.site-footer {
			padding: 3rem 1.2rem 3rem;
		}
		.footer-shell {
			grid-template-columns: 1fr;
			grid-template-areas:
				'brand'
				'links'
				'meta';
			gap: 1.35rem;
		}
		.footer-links {
			justify-self: stretch;
			padding-top: 1.2rem;
			padding-bottom: 1.8rem;
			border-top: 1px solid var(--line);
			gap: 0.8rem;
			letter-spacing: 0.12em;
		}
		.footer-meta {
			margin-top: 0;
			padding-top: 1.1rem;
			border-top: 1px solid var(--line);
		}
	}
</style>
