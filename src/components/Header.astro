---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>

import { SITE_TITLE } from '../consts';
import Wordmark from '../assets/brand/wordmark-color-light-bg.png';
import HeaderLink from './HeaderLink.astro';
import {
	DEFAULT_LOCALE,
	HTML_LANG,
	LOCALE_LABELS,
	LOCALES,
	localeHref,
	type Locale,
} from '../i18n/config';
import { isRouteAvailable } from '../i18n/availability';
import { useTranslations } from '../i18n/messages';

interface Props {
	lang?: Locale;
	/**
	 * Map of locale → URL on the current page. Locales absent from this map are
	 * rendered as inert <span> in the switcher (translation unavailable).
	 */
	translations?: Partial<Record<Locale, string>>;
}

const { lang, translations } = Astro.props;
const activeLocale: Locale = lang ?? DEFAULT_LOCALE;
const t = useTranslations(activeLocale).nav;

type NavItem = { path: string; label: string };
const navItems: NavItem[] = [
	{ path: '/', label: t.home },
	{ path: '/engineering/', label: t.engineering },
];
const homeHref = localeHref(activeLocale, '/');
---

<header class="site-header">
	<nav>
		<a class="logo" href={homeHref} aria-label={SITE_TITLE}>
			<img
				src={Wordmark.src}
				width={Wordmark.width}
				height={Wordmark.height}
				alt={`${SITE_TITLE} wordmark`}
				loading="eager"
				decoding="async"
			/>
		</a>
		<div class="internal-links" aria-label="Primary navigation">
			{navItems.map((item) =>
				isRouteAvailable(item.path, activeLocale) ? (
					<HeaderLink href={localeHref(activeLocale, item.path)}>{item.label}</HeaderLink>
				) : (
					<span class="nav-unavailable" aria-disabled="true" title={t.unavailableTitle}>
						{item.label}
					</span>
				),
			)}
		</div>
		<div class="utility-links">
			<div class="lang-switcher" aria-label={t.languageLabel}>
				{LOCALES.map((locale) => {
					const url = translations?.[locale];
					if (locale === activeLocale) {
						return (
							<span class="lang-active" aria-current="page" lang={HTML_LANG[locale]}>
								{LOCALE_LABELS[locale]}
							</span>
						);
					}
					if (url) {
						return (
							<a href={url} hreflang={HTML_LANG[locale]} lang={HTML_LANG[locale]}>
								{LOCALE_LABELS[locale]}
							</a>
						);
					}
					return (
						<span
							class="lang-unavailable"
							aria-disabled="true"
							title={t.unavailableTitle}
							lang={HTML_LANG[locale]}
						>
							{LOCALE_LABELS[locale]}
						</span>
					);
				})}
			</div>
			<div class="social-links" aria-label="Social links">
				<a href="https://github.com/sublang-ai" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">SubLang on GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href="https://x.com/sublang_ai" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">SubLang on X</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 2rem;
		background: rgba(247, 244, 239, 0.8);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		height: 72px;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		border-bottom: none;
	}
	.logo img {
		height: 30px;
		width: auto;
		border-radius: 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.internal-links a {
		border-bottom: none;
		color: var(--ink-muted);
	}
	.internal-links a.active {
		color: var(--ink);
	}
	.internal-links .nav-unavailable {
		color: var(--ink-muted);
		opacity: 0.4;
		cursor: not-allowed;
	}
	.utility-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.lang-switcher {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.lang-switcher a {
		border-bottom: none;
		color: var(--ink-muted);
		transition: color 0.2s ease;
	}
	.lang-switcher a:hover {
		color: var(--accent);
	}
	.lang-switcher .lang-active {
		color: var(--ink);
	}
	.lang-switcher .lang-unavailable {
		color: var(--ink-muted);
		opacity: 0.4;
		cursor: not-allowed;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social-links a {
		display: inline-flex;
		color: var(--ink-muted);
		border-bottom: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
		transform: translateY(-1px);
	}
	.social-links svg {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.utility-links {
			gap: 0.75rem;
		}
		.site-header {
			padding: 0 1.2rem;
		}
		.logo img {
			height: 24px;
		}
		.internal-links {
			gap: 1rem;
			letter-spacing: 0.16em;
		}
		.lang-switcher {
			letter-spacing: 0.14em;
			gap: 0.4rem;
		}
	}
</style>
