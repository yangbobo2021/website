		<!-- Mobile CTA Functionality -->
		<script is:inline define:vars={{ installUrl: `https://sublang.ai${localeHref(locale, '/keysync/download/')}` }}>
			(function () {
				var INSTALL_URL = installUrl;
				var TOAST_DURATION = 2000;

				function copyToClipboard(text, button) {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(function () {
							showButtonSuccess(button);
						}).catch(function () {
							fallbackCopy(text, button);
						});
					} else {
						fallbackCopy(text, button);
					}
				}

				function fallbackCopy(text, button) {
					var textarea = document.createElement('textarea');
					textarea.value = text;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					try {
						document.execCommand('copy');
						showButtonSuccess(button);
					} catch (err) {
						showButtonError(button);
					}
					document.body.removeChild(textarea);
				}

				function showButtonSuccess(button) {
					var textEl = button.querySelector('.ks-final-copy-text') || button.querySelector('.ks-mobile-cta-copy-text');
					if (textEl) {
						textEl.textContent = 'Copied!';
					}
					button.classList.add('ks-copy-success');
					// Swap icon to checkmark
					var svgEl = button.querySelector('svg');
					if (svgEl) {
						svgEl.innerHTML = '<path d="M20 6 9 17l-5-5"></path>';
					}
				}

				function showButtonError(button) {
					var textEl = button.querySelector('.ks-final-copy-text');
					var originalText = textEl?.textContent || '';
					if (textEl) {
						textEl.textContent = 'Failed';
					}
					setTimeout(function () {
						if (textEl) textEl.textContent = originalText;
					}, TOAST_DURATION);
				}

				// Copy URL button
				var copyBtn = document.getElementById('mobile-cta-copy');
				if (copyBtn) {
					copyBtn.addEventListener('click', function (e) {
						e.preventDefault();
						copyToClipboard(INSTALL_URL, copyBtn);
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'mobile_cta_copy_url', {
								event_category: 'engagement',
								event_label: 'keysync_mobile',
							});
						}
					});
				}

				// Final CTA Copy Link button
				var finalCopyBtn = document.getElementById('final-mobile-cta-copy');
				if (finalCopyBtn) {
					finalCopyBtn.addEventListener('click', function (e) {
						e.preventDefault();
						copyToClipboard(INSTALL_URL, finalCopyBtn);
						finalCopyBtn.blur();
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'final_cta_copy_url', {
								event_category: 'engagement',
								event_label: 'keysync_mobile_final',
							});
						}
					});
				}
			})();
		</script>
	</body>

	<style>
	/* KeySync subsite — ported into the SubLang light design system.
	   Reuses global tokens (--ink, --accent, --line, --surface, fonts) and the
	   shared .button / .tag / .card styles; ks- classes add layout local to
	   this page. */
	.ks-main {
		--ks-mono: var(--font-mono);
		--ks-page: #fdfcf9;
		--ks-surface-2: #faf9f5;
		--ks-line: #ece9e2;
		--ks-shadow-card: 0 14px 34px rgba(21, 22, 26, 0.05);
		--ks-shadow-float: 0 22px 56px rgba(21, 22, 26, 0.075);
		--ks-accent-soft: rgba(137, 15, 188, 0.09);
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		background: var(--ks-page);
	}
	:global(.site-header) {
		background: rgba(253, 252, 249, 0.86);
		border-bottom-color: var(--ks-line);
	}

	/* Full-width section bands with a centered inner column. */
	.ks-band {
		padding: 5.5rem 0;
		border-top: 1px solid var(--ks-line);
	}
	.ks-wrap {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* ---------- HERO ---------- */
	.ks-hero-band {
		border-top: none;
		padding: 4.5rem 0 4rem;
		text-align: center;
	}
	.ks-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: ks-pulse 2s infinite;
	}
	@keyframes ks-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.35; }
	}
	.ks-hero h1 {
		font-size: clamp(1.9rem, 4.2vw, 3rem);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.025em;
		max-width: 16ch;
		margin: 1.4rem auto 1.3rem;
	}
	/* Chinese-specific adjustments */
	:lang(zh) .ks-hero h1 {
		display: block;
		width: 100%;
		letter-spacing: 0.01em;
		line-height: 1.35;
		max-width: none;
	}
	.ks-hl {
		color: var(--accent);
	}
	.ks-sub {
		font-size: clamp(1.03rem, 1.35vw, 1.16rem);
		line-height: 1.58;
		color: var(--ink-soft);
		max-width: 55ch;
		margin: 0 auto 2rem;
	}
	.ks-sub b {
		color: var(--ink);
		font-weight: 600;
	}
	.ks-cta-row {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 1.6rem;
	}
	.ks-trust {
		list-style: none;
		display: flex;
		gap: 1.4rem;
		justify-content: center;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}
	.ks-trust li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.ks-trust svg {
		width: 15px;
		height: 15px;
		color: var(--accent);
	}

	/* ---------- HERO VISUAL ---------- */
	.ks-stage {
		max-width: 1000px;
		margin: 3.5rem auto 0;
		text-align: left;
	}
	.ks-stage-frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		padding: 1.8rem;
		box-shadow: var(--ks-shadow-float);
	}
	.ks-stage-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	.ks-panel {
		position: relative;
		z-index: 2;
		background: var(--ks-surface-2);
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		padding: 1rem 1rem 0.85rem;
