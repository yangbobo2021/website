import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { Image } from 'astro:assets';
import keysyncScreenshot from '../../../assets/keysync-screenshot.png';
import xiaoyiQrCode from '../../../assets/xiaoyi-qr-code.png';
import { HTML_LANG, NON_DEFAULT_LOCALES, localeHref, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/messages';
import { ImageMetadata } from 'astro:assets';
import appleLogo from '../../../assets/apple.svg';
import windowsLogo from '../../../assets/windows.svg';
import linuxLogo from '../../../assets/linux.svg';

export function getStaticPaths() {
	return NON_DEFAULT_LOCALES.map((locale) => ({
		params: { locale },
	}));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale).keysync;
const showContactQr = locale === 'zh';

const platformLogos: Record<string, { src: ImageMetadata; alt: string }> = {
	macOS: { src: appleLogo, alt: 'macOS' },
	Windows: { src: windowsLogo, alt: 'Windows' },
	Linux: { src: linuxLogo, alt: 'Linux' },
};

const PAGE_TITLE = t.pageTitle;
const PAGE_DESCRIPTION = t.pageDescription;
const KEYSYNC_DOWNLOAD_URL = 'https://keysync.sublang.ai/keysync/download';

const PLATFORM_PRIORITY = [
	{ platform: 'macOS', kind: 'dmg', label: 'macOS' },
	{ platform: 'Windows', kind: 'installer', label: 'Windows' },
	{ platform: 'Linux', kind: 'appimage', label: 'Linux' },
	{ platform: 'Linux CLI', kind: 'tar.gz', label: 'Linux CLI' },
];
const PLATFORM_ORDER = [
	{ platform: 'macOS', label: 'macOS' },
	{ platform: 'Windows', label: 'Windows' },
	{ platform: 'Linux', label: 'Linux' },
	{ platform: 'Linux CLI', label: 'Linux CLI' },
];

const ARCH_PRIORITY = ['arm64', 'x64', 'x86_64', 'amd64'];
const LINUX_DOWNLOAD_ARCH_ORDER = ['x64', 'x86_64', 'amd64', 'arm64'];
const downloadT = useTranslations(locale).keysyncDownload;
const KIND_LABELS: Record<string, string> = {
	dmg: downloadT.kindLabels.installer,
	installer: downloadT.kindLabels.installer,
	appimage: downloadT.kindLabels.appimage,
	deb: downloadT.kindLabels.deb,
	portable: downloadT.kindLabels.portable,
	'tar.gz': downloadT.kindLabels.tarball,
};

type ManifestArtifact = {
	platform: string;
	kind?: string;
	arch?: string;
	version?: string;
	fileName: string;
	url: string;
	size?: number | string;
	sha512?: string;
};

function toNumber(value: unknown): number {
	if (typeof value === 'number' && Number.isFinite(value)) {
		return value;
	}
	if (typeof value === 'string') {
		const parsed = Number(value);
		if (Number.isFinite(parsed)) {
			return parsed;
		}
	}
	return 0;
}

function formatBytes(bytes: number | string) {
	const sizeNumber = toNumber(bytes);
	if (!sizeNumber || sizeNumber <= 0) return 'Unknown size';
	const units = ['B', 'KB', 'MB', 'GB'];
	let size = sizeNumber;
	let unit = 0;
	while (size >= 1024 && unit < units.length - 1) {
		size /= 1024;
		unit += 1;
	}
	return `${size.toFixed(1)} ${units[unit]}`;
}

function pickArtifact(
	artifacts: {
		platform: string;
		kind?: string;
		arch?: string;
		version?: string;
		fileName: string;
		url: string;
		size?: number | string;
	}[],
	platform: string,
	kind: string,
) {
	const target = artifacts.filter(
		(item) => item.platform === platform && (item.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
	if (target.length === 0) {
		return null;
	}
	const ordered = [...target].sort((a, b) => {
		const ai = ARCH_PRIORITY.indexOf((a.arch ?? '').toLowerCase());
		const bi = ARCH_PRIORITY.indexOf((b.arch ?? '').toLowerCase());
		if (ai !== bi) {
			return (ai === -1 ? ARCH_PRIORITY.length : ai) - (bi === -1 ? ARCH_PRIORITY.length : bi);
		}
		return a.fileName.localeCompare(b.fileName);
	});
	return ordered[0];
}

let allArtifacts: {
	platform: string;
	kind?: string;
	arch?: string;
	version?: string;
	fileName: string;
	url: string;
	size?: number;
	sha512?: string;
}[] = [];

type DownloadCard = ManifestArtifact & {
	platformLabel: string;
	kindLabel: string;
	sizeLabel: string;
	isCli: boolean;
};

type FeaturedDownloadAction = {
	label: string;
	url: string;
	meta: string;
};

type FeaturedDownloadCard = {
	platformKey: string;
	title: string;
	description: string;
	primary?: FeaturedDownloadAction;
	secondary: FeaturedDownloadAction[];
};

const platformIndex = (platform: string) => PLATFORM_ORDER.findIndex((item) => item.platform === platform);
const downloadCards: DownloadCard[] = allArtifacts
	.filter((artifact) => !!artifact.url && !!artifact.fileName)
	.map((artifact) => ({
		...artifact,
		platformLabel:
			PLATFORM_ORDER.find((entry) => entry.platform === artifact.platform)?.label || artifact.platform,
		kindLabel: KIND_LABELS[(artifact.kind ?? '').toLowerCase()] || artifact.kind || 'file',
		sizeLabel: formatBytes(toNumber(artifact.size)),
		isCli: artifact.platform === 'Linux CLI',
	}))
	.sort((a, b) => {
		const pa = platformIndex(a.platform);
		const pb = platformIndex(b.platform);
		if (pa !== pb) {
			return (pa === -1 ? PLATFORM_ORDER.length : pa) - (pb === -1 ? PLATFORM_ORDER.length : pb);
		}
		const ka = ARCH_PRIORITY.indexOf((a.arch ?? '').toLowerCase());
		const kb = ARCH_PRIORITY.indexOf((b.arch ?? '').toLowerCase());
		if (ka !== kb) {
			return (ka === -1 ? ARCH_PRIORITY.length : ka) - (kb === -1 ? ARCH_PRIORITY.length : kb);
		}
		return a.fileName.localeCompare(b.fileName);
	});

function findDownloadCard(platform: string, kind: string, preferredArch: string) {
	const matches = downloadCards.filter(
		(artifact) => artifact.platform === platform && (artifact.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
	return matches.find((artifact) => (artifact.arch ?? '').toLowerCase() === preferredArch) ?? matches[0] ?? null;
}

function findDownloadCards(platform: string, kind: string) {
	return downloadCards.filter(
		(artifact) => artifact.platform === platform && (artifact.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
}

function linuxArchIndex(artifact: DownloadCard) {
	const index = LINUX_DOWNLOAD_ARCH_ORDER.indexOf((artifact.arch ?? '').toLowerCase());
	return index === -1 ? LINUX_DOWNLOAD_ARCH_ORDER.length : index;
}

function downloadAction(artifact: DownloadCard | null, label: string): FeaturedDownloadAction | undefined {
	if (!artifact) return undefined;
	return {
		label,
		url: artifact.url,
		meta: `${artifact.arch ? artifact.arch : 'Universal'} · ${artifact.sizeLabel}`,
	};
}

const macInstaller = findDownloadCard('macOS', 'dmg', 'arm64');
const windowsInstaller = findDownloadCard('Windows', 'installer', 'x64');
const linuxAppImage = findDownloadCard('Linux', 'appimage', 'x64');
const linuxAppImageArm = findDownloadCard('Linux', 'appimage', 'arm64');
const linuxCliDownloads = [...findDownloadCards('Linux CLI', 'tar.gz')].sort((a, b) => linuxArchIndex(a) - linuxArchIndex(b));
const windowsPortable = findDownloadCard('Windows', 'portable', 'x64');
const linuxSecondaryActions = [
	linuxAppImageArm?.url !== linuxAppImage?.url
		? downloadAction(linuxAppImageArm, downloadT.platforms.Linux.appImageArm)
		: undefined,
	...linuxCliDownloads.map((artifact) => downloadAction(artifact, downloadT.cli.generic(artifact.arch ?? downloadT.cli.universal))),
].filter(Boolean) as FeaturedDownloadAction[];

const featuredDownloadCards: FeaturedDownloadCard[] = [
	{
		platformKey: 'macOS',
		title: downloadT.platforms.macOS.title,
		description: downloadT.platforms.macOS.description,
		primary: downloadAction(macInstaller, downloadT.platforms.macOS.primary),
		secondary: [],
	},
	{
		platformKey: 'Windows',
		title: downloadT.platforms.Windows.title,
		description: downloadT.platforms.Windows.description,
		primary: downloadAction(windowsInstaller, downloadT.platforms.Windows.primary),
		secondary: [downloadAction(windowsPortable, downloadT.platforms.Windows.portable)].filter(Boolean) as FeaturedDownloadAction[],
	},
	{
		platformKey: 'Linux',
		title: downloadT.platforms.Linux.title,
		description: downloadT.platforms.Linux.description,
		primary: downloadAction(linuxAppImage, downloadT.platforms.Linux.primary),
		secondary: linuxSecondaryActions,
	},
];

const translations = { en: '/keysync/', zh: '/zh/keysync/' } as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([loc, path]) => ({
		locale: loc,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			lang={locale}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={locale} translations={translations} hasKeysync />
		<main class="ks-main">
			<!-- HERO -->
			<header class="ks-band ks-hero-band">
				<div class="ks-wrap ks-hero">
					<span class="tag"><span class="ks-dot" aria-hidden="true"></span>{t.hero.tag}</span>
					<h1 set:html={t.hero.headline} />
					<p class="ks-sub" set:html={t.hero.sub} />
				<!-- Desktop CTA (hidden on mobile/tablet < 1024px) -->
					<div class="ks-cta-row ks-desktop-cta">
						<a href={localeHref(locale, '/keysync/download/')} class="button primary">
							{t.hero.ctaDownload}
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
						</a>
						<a href="#how" class="button">{t.hero.ctaHow}</a>
					</div>

					<!-- Mobile CTA (hidden on desktop >= 1024px) -->
					<div class="ks-mobile-cta" id="mobile-cta">
						<div class="ks-mobile-cta-head">
							<svg class="ks-mobile-cta-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
								<line x1="8" y1="21" x2="16" y2="21"></line>
								<line x1="12" y1="17" x2="12" y2="21"></line>
							</svg>
							<h3>{t.hero.mobileCta.title}</h3>
						</div>
						<p class="ks-mobile-cta-desc">{t.hero.mobileCta.desc}</p>

						<div class="ks-mobile-url-display">
							<span class="ks-mobile-url">sublang.ai{localeHref(locale, '/keysync/download/')}</span>
							<button class="ks-mobile-copy-btn-primary" id="mobile-cta-copy" type="button">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
									<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
								</svg>
								<span class="ks-mobile-cta-copy-text">{t.hero.mobileCta.copy}</span>
							</button>
						</div>
					</div>

					<ul class="ks-trust">
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.trust[0]}</li>
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.trust[1]}</li>
						<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.trust[2]}</li>
					</ul>

					<!-- HERO VISUAL: source of truth -> hub -> tools -->
					<div class="ks-stage">
						<div class="ks-stage-frame">
							<div class="ks-stage-grid">
								<!-- LEFT: source of truth -->
								<div class="ks-panel">
									<div class="ks-panel-label">{t.hero.visual.sourceLabel} <span class="ks-tagged">{t.hero.visual.sourceBadge}</span></div>
									<div class="ks-kv"><span class="k">{t.hero.visual.keys.anthropic}</span><span class="v secret">sk-ant-••••</span></div>
									<div class="ks-kv"><span class="k">{t.hero.visual.keys.openai}</span><span class="v secret">sk-••••••••</span></div>
									<div class="ks-kv"><span class="k">{t.hero.visual.keys.google}</span><span class="v secret">AIza••••••</span></div>
									<div class="ks-kv"><span class="k">{t.hero.visual.keys.model}</span><span class="v">claude-opus-4</span></div>
									<div class="ks-kv"><span class="k">{t.hero.visual.keys.endpoint}</span><span class="v">api.proxy.dev</span></div>
								</div>

								<!-- MIDDLE: hub -->
								<div class="ks-hub">
									<div class="ks-hub-core">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
									</div>
									<div class="ks-hub-name">{t.hero.visual.hubName}</div>
								</div>

								<!-- RIGHT: tools -->
								<div class="ks-tools">
									<div class="ks-toolcard">
										<div class="ks-tool-ico">{t.keysyncShortNames.claudeCode}</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">{t.hero.visual.tools.claudeCode}</div><div class="ks-tool-path">{t.keysyncPaths.anthropic}</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.visual.synced}</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">{t.keysyncShortNames.openclaw}</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">{t.hero.visual.tools.openclaw}</div><div class="ks-tool-path">{t.keysyncPaths.openclaw}</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.visual.synced}</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">{t.keysyncShortNames.hermes}</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">{t.hero.visual.tools.hermes}</div><div class="ks-tool-path">{t.keysyncPaths.hermes}</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.visual.synced}</div>
									</div>
									<div class="ks-toolcard">
										<div class="ks-tool-ico">{t.keysyncShortNames.codex}</div>
										<div class="ks-tool-meta"><div class="ks-tool-name">{t.hero.visual.tools.codexCli}</div><div class="ks-tool-path">{t.keysyncPaths.codex}</div></div>
										<div class="ks-synced"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{t.hero.visual.synced}</div>
									</div>
								</div>

								<!-- animated connectors -->
								<svg class="ks-flow" preserveAspectRatio="none" viewBox="0 0 1000 260" aria-hidden="true">
									<line x1="320" y1="130" x2="445" y2="130"></line>
									<line x1="555" y1="130" x2="680" y2="60"></line>
									<line x1="555" y1="130" x2="680" y2="107"></line>
									<line x1="555" y1="130" x2="680" y2="153"></line>
									<line x1="555" y1="130" x2="680" y2="200"></line>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</header>

			<!-- PROBLEM -->
			<section class="ks-band ks-problem">
				<div class="ks-wrap ks-problem-grid">
					<div>
						<div class="ks-sec-eyebrow">{t.problem.eyebrow}</div>
						<h2 class="ks-sec-title">{t.problem.title}</h2>
						<ul class="ks-pain-list">
							<li><span set:html={t.problem.items[0]} /></li>
							<li><span set:html={t.problem.items[1]} /></li>
							<li><span set:html={t.problem.items[2]} /></li>
							<li><span set:html={t.problem.items[3]} /></li>
						</ul>
					</div>
					<div class="ks-drift-visual" aria-label="Illustration of provider configurations drifting across devices">
						<div class="ks-drift-devices">
							<!-- Work Laptop - just updated -->
							<div class="ks-device-card ks-card-synced">
								<div class="ks-device-header">
									<div class="ks-device-info">
										<div class="ks-device-icon ks-icon-laptop" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M1 20h22"/></svg>
										</div>
										<span class="ks-device-name">Work Laptop</span>
									</div>
									<span class="ks-device-status ks-status-just-updated">
										<svg class="ks-status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
										'Key-old' updated to 'Key-new'
									</span>
								</div>
								<div class="ks-device-rows">
									<div class="ks-device-row">
										<span class="ks-tool-name">Claude Code <span class="ks-tool-key ks-key-new">key-new</span></span>
										<span class="ks-tool-status ks-status-connected">connected</span>
									</div>
									<div class="ks-row-divider"></div>
									<div class="ks-device-row">
										<span class="ks-tool-name">Codex <span class="ks-tool-key ks-key-new">key-new</span></span>
										<span class="ks-tool-status ks-status-connected">connected</span>
									</div>
									<div class="ks-row-divider"></div>
									<div class="ks-device-row">
										<span class="ks-tool-name">OpenClaw <span class="ks-tool-key ks-key-new">key-new</span></span>
										<span class="ks-tool-status ks-status-connected">connected</span>
									</div>
									<div class="ks-row-divider"></div>
									<div class="ks-device-row">
										<span class="ks-tool-name">Hermes <span class="ks-tool-key ks-key-new">key-new</span></span>
										<span class="ks-tool-status ks-status-connected">connected</span>
									</div>
								</div>
							</div>

							<!-- Home Desktop - not synced -->
							<div class="ks-device-card ks-card-stale">
								<div class="ks-device-header">
									<div class="ks-device-info">
										<div class="ks-device-icon ks-icon-desktop" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
										</div>
										<span class="ks-device-name">Home Desktop</span>
									</div>
									<span class="ks-device-status ks-status-not-synced">
										<svg class="ks-status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
										Not Synced
									</span>
								</div>
								<div class="ks-device-rows">
									<div class="ks-device-row">
										<span class="ks-tool-name">Codex <span class="ks-tool-key ks-key-old">key-old</span></span>
										<span class="ks-tool-status ks-status-disconnected">disconnected</span>
									</div>
									<div class="ks-row-divider"></div>
									<div class="ks-device-row">
										<span class="ks-tool-name">Hermes <span class="ks-tool-key ks-key-old">key-old</span></span>
										<span class="ks-tool-status ks-status-disconnected">disconnected</span>
									</div>
								</div>
							</div>

							<!-- Server - not synced -->
							<div class="ks-device-card ks-card-stale">
								<div class="ks-device-header">
									<div class="ks-device-info">
										<div class="ks-device-icon ks-icon-server" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><circle cx="6" cy="6" r="1"/><circle cx="6" cy="18" r="1"/></svg>
										</div>
										<span class="ks-device-name">Server</span>
									</div>
									<span class="ks-device-status ks-status-not-synced">
										<svg class="ks-status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
										Not Synced
									</span>
								</div>
								<div class="ks-device-rows">
									<div class="ks-device-row">
										<span class="ks-tool-name">Claude Code <span class="ks-tool-key ks-key-old">key-old</span></span>
										<span class="ks-tool-status ks-status-disconnected">disconnected</span>
									</div>
									<div class="ks-row-divider"></div>
									<div class="ks-device-row">
										<span class="ks-tool-name">Codex <span class="ks-tool-key ks-key-old">key-old</span></span>
										<span class="ks-tool-status ks-status-disconnected">disconnected</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- MOBILE: 3-step overview -->
			<section class="ks-band ks-mobile-steps ks-mobile-only" aria-labelledby="ks-mobile-steps-title">
				<div class="ks-wrap">
