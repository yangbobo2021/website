import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import HomePageBody from '../../components/pages/HomePageBody.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { HTML_LANG, NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
	return NON_DEFAULT_LOCALES.map((locale) => ({
		params: { locale },
	}));
}

const { locale } = Astro.params as { locale: Locale };
const translations = { en: '/', zh: '/zh/' } as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([loc, path]) => ({
		locale: loc,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			lang={locale}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={locale} translations={translations} />
		<HomePageBody lang={locale} />
		<Footer lang={locale} />
	</body>
</html>
