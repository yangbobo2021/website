import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { DEFAULT_LOCALE } from '../../i18n/config';
import { useTranslations } from '../../i18n/messages';
import { GADS_CONVERSION_ID, SITE_GADS_ID } from '../../consts';
import appleLogo from '../../assets/apple.svg';
import windowsLogo from '../../assets/windows.svg';
import linuxLogo from '../../assets/linux.svg';

const t = useTranslations(DEFAULT_LOCALE).keysyncDownload;

const PAGE_TITLE = t.pageTitle;
const PAGE_DESCRIPTION = t.pageDescription;
const KEYSYNC_DOWNLOAD_URL = 'https://keysync.sublang.ai/keysync/download';
const KEYSYNC_LATEST_MANIFEST_URL = 'https://keysync.sublang.ai/keysync-updates/latest.json';
const downloadRuntimeConfig = {
	manifestUrl: KEYSYNC_LATEST_MANIFEST_URL,
	fallbackUrl: KEYSYNC_DOWNLOAD_URL,
	gadsId: SITE_GADS_ID,
	conversionId: GADS_CONVERSION_ID,
	copy: {
		platforms: t.platforms,
		cli: {
			generic: t.cli.generic('{arch}'),
			universal: t.cli.universal,
		},
		empty: t.empty,
		manifest: {
			unavailable: t.manifest.unavailable,
			releasedPattern: t.manifest.released('{date}'),
		},
		logos: {
			macOS: { src: appleLogo.src, alt: 'macOS' },
			Windows: { src: windowsLogo.src, alt: 'Windows' },
			Linux: { src: linuxLogo.src, alt: 'Linux' },
		},
	},
};

const translations = { en: '/keysync/download/', zh: '/zh/keysync/download/' } as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([locale, path]) => ({
		locale,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			lang={DEFAULT_LOCALE}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={DEFAULT_LOCALE} translations={translations} />
		<main class="ks-download-main">
			<!-- Breadcrumb -->
			<nav class="ks-breadcrumb" aria-label="Breadcrumb">
				<a href="/keysync/">KeySync</a>
				<span class="ks-breadcrumb-sep" aria-hidden="true">/</span>
				<span aria-current="page">{t.breadcrumb}</span>
			</nav>

			<!-- Download section -->
			<section class="ks-download-section" data-keysync-download-root>
				<div class="ks-download-head">
					<h1>{t.title}</h1>
				</div>

				<div class="ks-download-grid" data-keysync-download-grid aria-live="polite"></div>
				<p class="ks-download-empty" data-keysync-download-empty hidden>
					{t.empty.text} <a href={KEYSYNC_DOWNLOAD_URL}>{t.empty.fallback}</a>.
				</p>

				<div class="ks-download-footer">
					<p class="ks-download-version" data-keysync-download-version>{t.manifest.loading}</p>
				</div>
			</section>
		</main>
		<Footer lang={DEFAULT_LOCALE} />

		<script is:inline define:vars={{ config: downloadRuntimeConfig }}>
			window.__KEYSYNC_DOWNLOAD_CONFIG__ = config;
		</script>
		<script type="module" src="/scripts/keysync-download-runtime.js"></script>
	</body>

	<style>
	.ks-download-main {
		--ks-page: #fdfcf9;
		--ks-surface-2: #faf9f5;
		--ks-line: #ece9e2;
		--ks-shadow-card: 0 14px 34px rgba(21, 22, 26, 0.05);
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		background: var(--ks-page);
	}
	:global(.site-header) {
		background: rgba(253, 252, 249, 0.86);
		border-bottom-color: var(--ks-line);
	}

	/* Breadcrumb */
	.ks-breadcrumb {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 1.5rem 2rem 0;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}
	.ks-breadcrumb a {
		border-bottom: none;
		color: var(--ink-muted);
		transition: color 0.2s ease;
	}
	.ks-breadcrumb a:hover {
		color: var(--accent);
	}
	.ks-breadcrumb-sep {
		margin: 0 0.5rem;
		opacity: 0.5;
	}

	/* Download section */
	.ks-download-section {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 2rem 2rem 4rem;
	}
	.ks-download-head {
		text-align: center;
		margin-bottom: 3rem;
	}
	.ks-download-head h1 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: 1rem;
	}
	.ks-download-intro {
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 50ch;
		margin: 0 auto 1rem;
	}
	.ks-download-version {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-muted);
	}

	/* Download grid */
	.ks-download-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.ks-download-choice {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--ks-surface-2);
		padding: 1.4rem;
		box-shadow: 0 18px 48px rgba(21, 22, 26, 0.1);
	}
	.ks-download-platform-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}
	.ks-platform-logo {
		width: 28px;
		height: 28px;
		flex-shrink: 0;
	}
	.ks-download-platform {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--ink);
	}
	.ks-download-desc {
		margin: 0 0 1.25rem;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.5;
		text-align: center;
	}
	.ks-download-actions {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.ks-download-entry {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
		transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}
	.ks-download-entry:hover,
	.ks-download-entry:focus-visible {
		border-color: var(--accent);
		background: rgba(137, 15, 188, 0.03);
	}
	.ks-download-entry:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.ks-download-entry span {
		flex: 1;
	}
	.ks-download-icon {
		flex-shrink: 0;
		color: var(--accent);
		transition: color 0.15s ease;
	}
	.ks-download-entry:hover .ks-download-icon {
		color: var(--accent-dark, var(--accent));
	}
	.ks-download-secondary {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* Empty state */
	.ks-download-empty {
		text-align: center;
		color: var(--ink-soft);
		font-size: 1rem;
	}
	.ks-download-empty a {
		color: var(--accent);
	}

	/* Footer */
	.ks-download-footer {
		margin-top: 3rem;
		text-align: center;
	}
	.ks-download-footer p {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--ink-muted);
		margin-bottom: 1rem;
	}
	.ks-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-bottom: none;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		transition: color 0.2s ease;
	}
	.ks-back-link:hover {
		color: var(--accent);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.ks-download-section {
			padding: 1.5rem 1.5rem 3rem;
		}
	}
	@media (max-width: 720px) {
		.ks-breadcrumb {
			padding: 1.2rem 1.2rem 0;
		}
		.ks-download-grid {
			grid-template-columns: 1fr;
		}
		.ks-download-section {
			padding: 1.2rem 1.2rem 2.5rem;
		}
	}
	</style>
</html>
