		flex-shrink: 0;
		width: 30px;
		height: 30px;
		border-radius: var(--radius-sm);
		display: grid;
		place-items: center;
		background: var(--surface);
		border: 1px solid var(--ks-line);
		font-family: var(--ks-mono);
		font-weight: 700;
		font-size: 0.78rem;
		color: var(--ink);
	}
	.ks-tool-meta { flex: 1; min-width: 0; }
	.ks-tool-name { font-weight: 600; font-size: 0.86rem; color: var(--ink); }
