import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { DEFAULT_LOCALE } from '../../i18n/config';
import { ImageMetadata } from 'astro:assets';
import appleLogo from '../../assets/apple.svg';
import windowsLogo from '../../assets/windows.svg';
import linuxLogo from '../../assets/linux.svg';

const platformLogos: Record<string, { src: ImageMetadata; alt: string }> = {
	macOS: { src: appleLogo, alt: 'macOS' },
	Windows: { src: windowsLogo, alt: 'Windows' },
	Linux: { src: linuxLogo, alt: 'Linux' },
};

const PAGE_TITLE = 'Download KeySync — One config for every AI agent';
const PAGE_DESCRIPTION =
	'Download KeySync for macOS, Windows, and Linux. Keep your AI agent providers, keys, models, and endpoints in one place and sync them everywhere.';
const KEYSYNC_DOWNLOAD_URL = 'https://demo.signoff.bio/keysync/download';
const KEYSYNC_LATEST_MANIFEST_URL = 'https://keysync.sublang.ai/keysync-updates/latest.json';

const PLATFORM_PRIORITY = [
	{ platform: 'macOS', kind: 'dmg', label: 'macOS' },
	{ platform: 'Windows', kind: 'installer', label: 'Windows' },
	{ platform: 'Linux', kind: 'appimage', label: 'Linux' },
	{ platform: 'Linux CLI', kind: 'tar.gz', label: 'Linux CLI' },
];
const PLATFORM_ORDER = [
	{ platform: 'macOS', label: 'macOS' },
	{ platform: 'Windows', label: 'Windows' },
	{ platform: 'Linux', label: 'Linux' },
	{ platform: 'Linux CLI', label: 'Linux CLI' },
];

const ARCH_PRIORITY = ['arm64', 'x64', 'x86_64', 'amd64'];
const LINUX_DOWNLOAD_ARCH_ORDER = ['x64', 'x86_64', 'amd64', 'arm64'];
const KIND_LABELS: Record<string, string> = {
	dmg: 'installer',
	installer: 'installer',
	appimage: 'AppImage',
	deb: 'Deb package',
	portable: 'portable zip',
	'tar.gz': 'tarball',
};

type ManifestArtifact = {
	platform: string;
	kind?: string;
	arch?: string;
	version?: string;
	fileName: string;
	url: string;
	size?: number | string;
	sha512?: string;
};

function toNumber(value: unknown): number {
	if (typeof value === 'number' && Number.isFinite(value)) {
		return value;
	}
	if (typeof value === 'string') {
		const parsed = Number(value);
		if (Number.isFinite(parsed)) {
			return parsed;
		}
	}
	return 0;
}

function formatBytes(bytes: number | string) {
	const sizeNumber = toNumber(bytes);
	if (!sizeNumber || sizeNumber <= 0) return 'Unknown size';
	const units = ['B', 'KB', 'MB', 'GB'];
	let size = sizeNumber;
	let unit = 0;
	while (size >= 1024 && unit < units.length - 1) {
		size /= 1024;
		unit += 1;
	}
	return `${size.toFixed(1)} ${units[unit]}`;
}

function pickArtifact(
	artifacts: {
		platform: string;
		kind?: string;
		arch?: string;
		version?: string;
		fileName: string;
		url: string;
		size?: number | string;
	}[],
	platform: string,
	kind: string,
) {
	const target = artifacts.filter(
		(item) => item.platform === platform && (item.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
	if (target.length === 0) {
		return null;
	}
	const ordered = [...target].sort((a, b) => {
		const ai = ARCH_PRIORITY.indexOf((a.arch ?? '').toLowerCase());
		const bi = ARCH_PRIORITY.indexOf((b.arch ?? '').toLowerCase());
		if (ai !== bi) {
			return (ai === -1 ? ARCH_PRIORITY.length : ai) - (bi === -1 ? ARCH_PRIORITY.length : bi);
		}
		return a.fileName.localeCompare(b.fileName);
	});
	return ordered[0];
}

let version = 'Latest';
let releaseDate = '';
let downloadRows: { label: string; platform: string; kind: string; url: string; fileName: string; size: number }[] = [];
let allArtifacts: {
	platform: string;
	kind?: string;
	arch?: string;
	version?: string;
	fileName: string;
	url: string;
	size?: number;
	sha512?: string;
}[] = [];
let manifestError = false;

try {
	const response = await fetch(KEYSYNC_LATEST_MANIFEST_URL, {
		headers: {
			accept: 'application/json',
		},
	});
	if (!response.ok) {
		throw new Error(`manifest fetch failed: ${response.status}`);
	}
	const manifest = (await response.json()) as {
		artifacts?: unknown[];
		version?: string;
		releaseDate?: string;
	};
	const rawArtifacts = Array.isArray(manifest?.artifacts) ? manifest.artifacts : [];
	const safeArtifacts = rawArtifacts.filter((item): item is ManifestArtifact => {
		if (!item || typeof item !== 'object') {
			return false;
		}
		const candidate = item as { platform?: unknown; fileName?: unknown; url?: unknown; version?: unknown; kind?: unknown; arch?: unknown };
		return (
			typeof candidate.platform === 'string' &&
			typeof candidate.fileName === 'string' &&
			typeof candidate.url === 'string'
		);
	});

	version = manifest?.version
		? manifest.version.startsWith('v')
			? manifest.version
			: `v${manifest.version}`
		: version;
	releaseDate = manifest?.releaseDate ? new Date(manifest.releaseDate).toISOString().slice(0, 10) : releaseDate;
	allArtifacts = safeArtifacts;

	downloadRows = PLATFORM_PRIORITY
		.map((entry) => {
			const artifact = pickArtifact(safeArtifacts, entry.platform, entry.kind);
			if (!artifact) {
				return null;
			}
			return {
				label: `${entry.label} ${KIND_LABELS[artifact.kind ?? ''] || (artifact.kind ?? '')}`,
				platform: entry.platform,
				kind: artifact.kind ?? '',
				url: artifact.url,
				fileName: artifact.fileName,
				size: toNumber(artifact.size),
			};
		})
		.filter(Boolean) as typeof downloadRows;

	if (downloadRows.length === 0 && allArtifacts.length > 0) {
		downloadRows = allArtifacts
			.filter((artifact) => !!artifact.url && !!artifact.fileName)
			.slice(0, 4)
			.map((artifact) => ({
				label: `${artifact.platform}${artifact.arch ? ` (${artifact.arch})` : ''}`,
				platform: artifact.platform,
				kind: artifact.kind ?? '',
				url: artifact.url,
				fileName: artifact.fileName,
				size: toNumber(artifact.size),
			}));
	}
	if (downloadRows.length === 0) {
		manifestError = true;
	}
} catch {
	manifestError = true;
}

type DownloadCard = ManifestArtifact & {
	platformLabel: string;
	kindLabel: string;
	sizeLabel: string;
	isCli: boolean;
};

type FeaturedDownloadAction = {
	label: string;
	url: string;
	meta: string;
};

type FeaturedDownloadCard = {
	platformKey: string;
	title: string;
	description: string;
	primary?: FeaturedDownloadAction;
	secondary: FeaturedDownloadAction[];
};

const platformIndex = (platform: string) => PLATFORM_ORDER.findIndex((item) => item.platform === platform);
const downloadCards: DownloadCard[] = allArtifacts
	.filter((artifact) => !!artifact.url && !!artifact.fileName)
	.map((artifact) => ({
		...artifact,
		platformLabel:
			PLATFORM_ORDER.find((entry) => entry.platform === artifact.platform)?.label || artifact.platform,
		kindLabel: KIND_LABELS[(artifact.kind ?? '').toLowerCase()] || artifact.kind || 'file',
		sizeLabel: formatBytes(toNumber(artifact.size)),
		isCli: artifact.platform === 'Linux CLI',
	}))
	.sort((a, b) => {
		const pa = platformIndex(a.platform);
		const pb = platformIndex(b.platform);
		if (pa !== pb) {
			return (pa === -1 ? PLATFORM_ORDER.length : pa) - (pb === -1 ? PLATFORM_ORDER.length : pb);
		}
		const ka = ARCH_PRIORITY.indexOf((a.arch ?? '').toLowerCase());
		const kb = ARCH_PRIORITY.indexOf((b.arch ?? '').toLowerCase());
		if (ka !== kb) {
			return (ka === -1 ? ARCH_PRIORITY.length : ka) - (kb === -1 ? ARCH_PRIORITY.length : kb);
		}
		return a.fileName.localeCompare(b.fileName);
	});

function findDownloadCard(platform: string, kind: string, preferredArch: string) {
	const matches = downloadCards.filter(
		(artifact) => artifact.platform === platform && (artifact.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
	return matches.find((artifact) => (artifact.arch ?? '').toLowerCase() === preferredArch) ?? matches[0] ?? null;
}

function findDownloadCards(platform: string, kind: string) {
	return downloadCards.filter(
		(artifact) => artifact.platform === platform && (artifact.kind ?? '').toLowerCase() === kind.toLowerCase(),
	);
}

function linuxArchIndex(artifact: DownloadCard) {
	const index = LINUX_DOWNLOAD_ARCH_ORDER.indexOf((artifact.arch ?? '').toLowerCase());
	return index === -1 ? LINUX_DOWNLOAD_ARCH_ORDER.length : index;
}

function downloadAction(artifact: DownloadCard | null, label: string): FeaturedDownloadAction | undefined {
	if (!artifact) return undefined;
	return {
		label,
		url: artifact.url,
		meta: `${artifact.arch ? artifact.arch : 'Universal'} · ${artifact.sizeLabel}`,
	};
}

const macInstaller = findDownloadCard('macOS', 'dmg', 'arm64');
const windowsInstaller = findDownloadCard('Windows', 'installer', 'x64');
const linuxAppImage = findDownloadCard('Linux', 'appimage', 'x64');
const linuxAppImageArm = findDownloadCard('Linux', 'appimage', 'arm64');
const linuxCliDownloads = [...findDownloadCards('Linux CLI', 'tar.gz')].sort((a, b) => linuxArchIndex(a) - linuxArchIndex(b));
const windowsPortable = findDownloadCard('Windows', 'portable', 'x64');
const linuxSecondaryActions = [
	linuxAppImageArm?.url !== linuxAppImage?.url
		? downloadAction(linuxAppImageArm, 'AppImage (arm64)')
		: undefined,
	...linuxCliDownloads.map((artifact) => downloadAction(artifact, `CLI (${artifact.arch ?? 'Universal'})`)),
].filter(Boolean) as FeaturedDownloadAction[];

const featuredDownloadCards: FeaturedDownloadCard[] = [
	{
		platformKey: 'macOS',
		title: 'macOS',
		description: 'Apple Silicon native, desktop-ready.',
		primary: downloadAction(macInstaller, 'macOS (Apple Silicon)'),
		secondary: [],
	},
	{
		platformKey: 'Windows',
		title: 'Windows',
		description: 'Installer or portable, x64 desktop.',
		primary: downloadAction(windowsInstaller, 'Installer (x64)'),
		secondary: [downloadAction(windowsPortable, 'Portable (x64)')].filter(Boolean) as FeaturedDownloadAction[],
	},
	{
		platformKey: 'Linux',
		title: 'Linux',
		description: 'AppImage for desktop, CLI for server.',
		primary: downloadAction(linuxAppImage, 'AppImage (x64)'),
		secondary: linuxSecondaryActions,
	},
];

const translations = { en: '/keysync/download/' } as const;
const alternates = (Object.entries(translations) as Array<[keyof typeof translations, string]>).map(
	([locale, path]) => ({
		locale,
		href: new URL(path, Astro.site).toString(),
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			lang={DEFAULT_LOCALE}
			alternates={alternates}
		/>
	</head>
	<body>
		<Header lang={DEFAULT_LOCALE} translations={translations} />
		<main class="ks-download-main">
			<!-- Breadcrumb -->
			<nav class="ks-breadcrumb" aria-label="Breadcrumb">
				<a href="/keysync/">KeySync</a>
				<span class="ks-breadcrumb-sep" aria-hidden="true">/</span>
				<span aria-current="page">Download</span>
			</nav>

			<!-- Download section -->
			<section class="ks-download-section">
				<div class="ks-download-head">
					<h1>Download KeySync</h1>
				</div>

				{featuredDownloadCards.length > 0 ? (
					<div class="ks-download-grid">
						{featuredDownloadCards.map((card) => {
							const logo = platformLogos[card.title];
							return (
							<article class="ks-download-choice">
								<div class="ks-download-platform-header">
									{logo && <img src={logo.src.src} alt={logo.alt} class="ks-platform-logo" />}
									<h2 class="ks-download-platform">{card.title}</h2>
								</div>
								<p class="ks-download-desc">{card.description}</p>
								<div class="ks-download-actions">
									{card.primary ? (
										<a href={card.primary.url} class="ks-download-entry">
											<span>{card.primary.label}</span>
											<svg class="ks-download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
												<polyline points="7 10 12 15 17 10"></polyline>
												<line x1="12" y1="15" x2="12" y2="3"></line>
											</svg>
										</a>
									) : (
										<a href={KEYSYNC_DOWNLOAD_URL} class="ks-download-entry">
											<span>Open download hub</span>
											<svg class="ks-download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
												<polyline points="7 10 12 15 17 10"></polyline>
												<line x1="12" y1="15" x2="12" y2="3"></line>
											</svg>
										</a>
									)}
									{card.secondary.length > 0 ? (
										<div class="ks-download-secondary">
											{card.secondary.map((action) => (
												<a href={action.url} class="ks-download-entry">
													<span>{action.label}</span>
													<svg class="ks-download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
														<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
														<polyline points="7 10 12 15 17 10"></polyline>
														<line x1="12" y1="15" x2="12" y2="3"></line>
													</svg>
												</a>
											))}
										</div>
									) : null}
								</div>
							</article>
							);
						})}
					</div>
				) : (
					<p class="ks-download-empty">
						No downloads available. <a href={KEYSYNC_DOWNLOAD_URL}>Open download hub</a>.
					</p>
				)}

				<div class="ks-download-footer">
					<p class="ks-download-version">
						{manifestError
							? 'Manifest unavailable — use fallback link below.'
							: `${version}${releaseDate ? ` · Released ${releaseDate}` : ''}`}
					</p>
				</div>
			</section>
		</main>
		<Footer lang={DEFAULT_LOCALE} />
	</body>

	<style>
	.ks-download-main {
		--ks-page: #fdfcf9;
		--ks-surface-2: #faf9f5;
		--ks-line: #ece9e2;
		--ks-shadow-card: 0 14px 34px rgba(21, 22, 26, 0.05);
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
		background: var(--ks-page);
	}
	:global(.site-header) {
		background: rgba(253, 252, 249, 0.86);
		border-bottom-color: var(--ks-line);
	}

	/* Breadcrumb */
	.ks-breadcrumb {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 1.5rem 2rem 0;
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}
	.ks-breadcrumb a {
		border-bottom: none;
		color: var(--ink-muted);
		transition: color 0.2s ease;
	}
	.ks-breadcrumb a:hover {
		color: var(--accent);
	}
	.ks-breadcrumb-sep {
		margin: 0 0.5rem;
		opacity: 0.5;
	}

	/* Download section */
	.ks-download-section {
		max-width: var(--grid-max);
		margin: 0 auto;
		padding: 2rem 2rem 4rem;
	}
	.ks-download-head {
		text-align: center;
		margin-bottom: 3rem;
	}
	.ks-download-head h1 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: 1rem;
	}
	.ks-download-intro {
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 50ch;
		margin: 0 auto 1rem;
	}
	.ks-download-version {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink-muted);
	}

	/* Download grid */
	.ks-download-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.ks-download-choice {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-md);
		background: var(--ks-surface-2);
		padding: 1.4rem;
		box-shadow: 0 18px 48px rgba(21, 22, 26, 0.1);
	}
	.ks-download-platform-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}
	.ks-platform-logo {
		width: 28px;
		height: 28px;
		flex-shrink: 0;
	}
	.ks-download-platform {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--ink);
	}
	.ks-download-desc {
		margin: 0 0 1.25rem;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.5;
		text-align: center;
	}
	.ks-download-actions {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.ks-download-entry {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ks-line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
		transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}
	.ks-download-entry:hover,
	.ks-download-entry:focus-visible {
		border-color: var(--accent);
		background: rgba(137, 15, 188, 0.03);
	}
	.ks-download-entry:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.ks-download-entry span {
		flex: 1;
	}
	.ks-download-icon {
		flex-shrink: 0;
		color: var(--accent);
		transition: color 0.15s ease;
	}
	.ks-download-entry:hover .ks-download-icon {
		color: var(--accent-dark, var(--accent));
	}
	.ks-download-secondary {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* Empty state */
	.ks-download-empty {
		text-align: center;
		color: var(--ink-soft);
		font-size: 1rem;
	}
	.ks-download-empty a {
		color: var(--accent);
	}

	/* Footer */
	.ks-download-footer {
		margin-top: 3rem;
		text-align: center;
	}
	.ks-download-footer p {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--ink-muted);
		margin-bottom: 1rem;
	}
	.ks-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-bottom: none;
		color: var(--ink-muted);
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		transition: color 0.2s ease;
	}
	.ks-back-link:hover {
		color: var(--accent);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.ks-download-section {
			padding: 1.5rem 1.5rem 3rem;
		}
	}
	@media (max-width: 720px) {
		.ks-breadcrumb {
			padding: 1.2rem 1.2rem 0;
		}
		.ks-download-grid {
			grid-template-columns: 1fr;
		}
		.ks-download-section {
			padding: 1.2rem 1.2rem 2.5rem;
		}
	}
	</style>
</html>